-            result.map_err(|error| format!("第 {} 行：{}", index + 1, error))
-        }).collect()
+    let mut events = Vec::new();
+    for (index, raw_line) in input.lines().enumerate() {
+        let line_number = index + 1;
+        let line = raw_line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let fields: Vec<&str> = line.split(',').map(|field| field.trim()).collect();
+        let event = parse_fields(&fields)
+            .map_err(|error| format!("第 {} 行：{}", line_number, error))?;
+        events.push(event);
+    }
+    Ok(events)
 }
+
+fn parse_fields(fields: &[&str]) -> Result<Event, String> {
+    match fields {
+        ["deposit", id, account, amount] => {
+            let id = checked_token(id, "请求ID无效")?;
+            let account = checked_token(account, "账户无效")?;
+            let cents = checked_amount(amount)?;
+            Ok(Event::Deposit { id, account, cents })
+        }
+        ["transfer", id, from, to, amount] => {
+            let id = checked_token(id, "请求ID无效")?;
+            let from = checked_token(from, "账户无效")?;
+            let to = checked_token(to, "账户无效")?;
+            let cents = checked_amount(amount)?;
+            Ok(Event::Transfer { id, from, to, cents })
+        }
+        _ => Err("流水格式无效".to_owned()),
+    }
+}
+
+fn checked_token(value: &str, error: &str) -> Result<String, String> {
+    if is_valid_token(value) {
+        Ok(value.to_owned())
+    } else {
+        Err(error.to_owned())
+    }
+}
+
+fn checked_amount(amount: &str) -> Result<i64, String> {
+    let cents = parse_cents(amount)?;
+    if cents <= 0 {
+        return Err("金额必须大于零".to_owned());
+    }
+    Ok(cents)
+}
