+/// Parses a decimal amount into an exact number of cents (`i64`).
+///
+/// Accepted grammar (after trimming surrounding whitespace):
+/// `-? DIGIT+ ( "." DIGIT{1,2} )?`
+///
+/// A leading `+`, exponents, empty integer/fraction parts, more than two
+/// fractional digits and any non-digit character are rejected. The conversion
+/// is exact and never panics; values outside the `i64` cents range (including
+/// `i64::MIN`) return an error.
 pub fn parse_cents(input: &str) -> Result<i64, String> {
-    let amount: f64 = input.trim().parse().map_err(|_| "金额无效".to_owned())?;
-    Ok((amount * 100.0) as i64)
+    let trimmed = input.trim();
+
+    let (negative, unsigned) = match trimmed.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, trimmed),
+    };
+
+    let (integer_part, fraction_part) = match unsigned.split_once('.') {
+        Some((integer, fraction)) => (integer, Some(fraction)),
+        None => (unsigned, None),
+    };
+
+    if integer_part.is_empty() {
+        return Err("金额无效：缺少整数部分".to_owned());
+    }
+    if !integer_part.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err("金额无效".to_owned());
+    }
+
+    // Accumulate in u128 so that `i64::MIN` (whose magnitude is not
+    // representable as a positive i64) can be handled, and so that arbitrarily
+    // long inputs fail cleanly instead of overflowing.
+    let mut magnitude: u128 = 0;
+    for byte in integer_part.bytes() {
+        magnitude = magnitude
+            .checked_mul(10)
+            .and_then(|value| value.checked_add(u128::from(byte - b'0')))
+            .ok_or_else(|| "金额无效：超出范围".to_owned())?;
+    }
+    magnitude = magnitude
+        .checked_mul(100)
+        .ok_or_else(|| "金额无效：超出范围".to_owned())?;
+
+    if let Some(fraction) = fraction_part {
+        if fraction.is_empty() {
+            return Err("金额无效：缺少小数部分".to_owned());
+        }
+        if fraction.len() > 2 {
+            return Err("金额无效：小数超过两位".to_owned());
+        }
+        if !fraction.bytes().all(|byte| byte.is_ascii_digit()) {
+            return Err("金额无效".to_owned());
+        }
+
+        let mut fractional: u128 = 0;
+        for byte in fraction.bytes() {
+            fractional = fractional * 10 + u128::from(byte - b'0');
+        }
+        if fraction.len() == 1 {
+            fractional *= 10;
+        }
+        magnitude = magnitude
+            .checked_add(fractional)
+            .ok_or_else(|| "金额无效：超出范围".to_owned())?;
+    }
+
+    const I64_MIN_MAGNITUDE: u128 = (i64::MAX as u128) + 1;
+
+    if negative {
+        if magnitude > I64_MIN_MAGNITUDE {
+            return Err("金额无效：超出范围".to_owned());
+        }
+        if magnitude == I64_MIN_MAGNITUDE {
+            Ok(i64::MIN)
+        } else {
+            Ok(-(magnitude as i64))
+        }
+    } else {
+        if magnitude > i64::MAX as u128 {
+            return Err("金额无效：超出范围".to_owned());
+        }
+        Ok(magnitude as i64)
+    }
 }
 
+/// Formats an exact number of cents as a decimal string with two fractional
+/// digits. The full `i64` range is supported and negative values keep their
+/// sign, so `parse_cents(&format_cents(cents)) == Ok(cents)`.
