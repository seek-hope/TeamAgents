+
+    #[test]
+    fn handles_full_i64_range_exactly() {
+        assert_eq!(parse_cents("92233720368547758.07"), Ok(i64::MAX));
+        assert_eq!(parse_cents("-92233720368547758.08"), Ok(i64::MIN));
+        assert!(parse_cents("92233720368547758.08").is_err());
+        assert!(parse_cents("-92233720368547758.09").is_err());
+        assert!(parse_cents("92233720368547759").is_err());
+        assert!(parse_cents("99999999999999999999999999999999999999999999").is_err());
+        assert_eq!(parse_cents("-0.00"), Ok(0));
+    }
+
+    #[test]
+    fn formats_full_range() {
+        assert_eq!(format_cents(0), "0.00");
+        assert_eq!(format_cents(1), "0.01");
+        assert_eq!(format_cents(-1), "-0.01");
+        assert_eq!(format_cents(-5), "-0.05");
+        assert_eq!(format_cents(-100), "-1.00");
+        assert_eq!(format_cents(i64::MAX), "92233720368547758.07");
+        assert_eq!(format_cents(i64::MIN), "-92233720368547758.08");
+    }
+
+    #[test]
+    fn round_trips_densely() {
+        // Deterministic sweep around zero plus the i64 extremes.
+        for cents in -20_000i64..=20_000 {
+            let text = format_cents(cents);
+            assert_eq!(parse_cents(&text), Ok(cents), "round trip failed for {text}");
+        }
+        let mut cents = i64::MIN;
+        while cents < i64::MIN + 20_000 {
+            assert_eq!(parse_cents(&format_cents(cents)), Ok(cents));
+            cents += 1;
+        }
+        let mut cents = i64::MAX - 20_000;
+        while cents < i64::MAX {
+            assert_eq!(parse_cents(&format_cents(cents)), Ok(cents));
+            cents += 1;
+        }
+        assert_eq!(parse_cents(&format_cents(i64::MAX)), Ok(i64::MAX));
+    }
+
+    #[test]
+    fn round_trips_exactly() {
+        for cents in [
+            0i64,
+            1,
+            -1,
+            5,
+            -5,
+            99,
+            -99,
+            100,
+            -100,
+            i64::MAX,
+            i64::MIN,
+            i64::MAX - 1,
+            i64::MIN + 1,
+            123456789012345,
+            -987654321098765,
+        ] {
+            let text = format_cents(cents);
+            assert_eq!(parse_cents(&text), Ok(cents), "round trip failed for {text}");
+        }
+    }
