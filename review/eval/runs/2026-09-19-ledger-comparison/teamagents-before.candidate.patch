+/// 请求 ID 与账户名的合法字符集：非空，且仅含 ASCII 字母、数字、下划线和连字符。
+pub(crate) fn valid_name(value: &str) -> bool {
+    !value.is_empty()
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+}
+
+fn parse_name(value: &str, label: &str) -> Result<String, String> {
+    if valid_name(value) {
+        Ok(value.to_owned())
+    } else {
+        Err(format!("{label}无效"))
+    }
+}
+
+/// 每笔金额必须严格大于零。
+fn parse_amount(text: &str) -> Result<i64, String> {
+    let cents = parse_cents(text)?;
+    if cents <= 0 {
+        return Err("金额必须大于零".to_owned());
+    }
+    Ok(cents)
+}
+
+fn parse_line(line: &str) -> Result<Event, String> {
+    let fields: Vec<&str> = line.split(',').map(str::trim).collect();
+    match fields.as_slice() {
+        ["deposit", id, account, amount] => Ok(Event::Deposit {
+            id: parse_name(id, "请求ID")?,
+            account: parse_name(account, "账户")?,
+            cents: parse_amount(amount)?,
+        }),
+        ["transfer", id, from, to, amount] => Ok(Event::Transfer {
+            id: parse_name(id, "请求ID")?,
+            from: parse_name(from, "源账户")?,
+            to: parse_name(to, "目标账户")?,
+            cents: parse_amount(amount)?,
+        }),
+        _ => Err("流水格式无效".to_owned()),
+    }
+}
