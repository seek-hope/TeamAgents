+    }
+
+    #[test]
+    fn is_exact_for_tricky_decimals() {
+        // 这些值用 f64 转换会截断到少一分。
+        assert_eq!(parse_cents("0.29"), Ok(29));
+        assert_eq!(parse_cents("0.07"), Ok(7));
+        assert_eq!(parse_cents("8.15"), Ok(815));
+        assert!(parse_cents("1.005").is_err());
+        let mut total = 0_i64;
+        for _ in 0..100 {
+            total += parse_cents("0.07").unwrap();
+        }
+        assert_eq!(total, 700);
+    }
+
+    #[test]
+    fn covers_full_i64_range_and_detects_overflow() {
+        assert_eq!(parse_cents("92233720368547758.07"), Ok(i64::MAX));
+        assert!(parse_cents("92233720368547758.08").is_err());
+        assert!(parse_cents("9223372036854775808").is_err());
+        assert_eq!(parse_cents("-92233720368547758.08"), Ok(i64::MIN));
+        assert!(parse_cents("-92233720368547758.09").is_err());
+        // 超长输入不能 panic/回绕。
+        assert!(parse_cents(&"9".repeat(400)).is_err());
+        assert!(parse_cents("-99999999999999999999999999.99").is_err());
+    }
+
+    #[test]
+    fn formats_negatives_with_sign() {
+        assert_eq!(format_cents(0), "0.00");
+        assert_eq!(format_cents(5), "0.05");
+        assert_eq!(format_cents(50), "0.50");
+        assert_eq!(format_cents(-1), "-0.01");
+        assert_eq!(format_cents(-99), "-0.99");
+        assert_eq!(format_cents(-100), "-1.00");
+        assert_eq!(format_cents(i64::MAX), "92233720368547758.07");
+        assert_eq!(format_cents(i64::MIN), "-92233720368547758.08");
+    }
+
+    #[test]
+    fn round_trips_over_a_wide_range() {
+        let mut samples = vec![
+            0_i64, 1, -1, 99, -99, 100, -100, 12345, -12345, i64::MAX, i64::MIN,
+            i64::MAX - 1, i64::MIN + 1, 10_i64.pow(18),
+        ];
+        // 用确定性伪随机序列覆盖整个范围的边角值。
+        let mut current: i64 = 1;
+        for _ in 0..4096 {
+            current = current
+                .wrapping_mul(6364136223846793005)
+                .wrapping_add(1442695040888963407);
+            samples.push(current);
+        }
+        for cents in samples {
+            let text = format_cents(cents);
+            assert_eq!(parse_cents(&text), Ok(cents), "往返失败: {cents} -> {text}");
+        }
+    }
+}
