+        assert_eq!(ledger.balance("bob"), Some(10));
+        assert_eq!(ledger.apply(&transfer("t1", "alice", "bob", 100)), Ok(true));
+        assert_eq!(ledger.balance("alice"), Some(900));
+        assert_eq!(ledger.balance("bob"), Some(110));
+        // 成功之后同 ID 重放仍然只生效一次。
+        assert_eq!(ledger.apply(&transfer("t1", "alice", "bob", 100)), Ok(false));
