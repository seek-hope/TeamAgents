+            "1.234", "1e2", "1E2", "0x1", "1,5", "1 2", "abc", "1.2.3", "１２", ".",
+        ] {
+            assert!(parse_cents(bad).is_err(), "应拒绝: {bad:?}");
+        }
+        // 首尾空白之外的空白仍非法。
