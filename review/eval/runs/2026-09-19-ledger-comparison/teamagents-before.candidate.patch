+//! 金额与「分」之间的精确转换。
+//!
+//! 金额在内部一律以 `i64` 分表示，绝不经过浮点数：二进制浮点无法精确表示
+//! 十进制小数（例如 `0.29 * 100.0 == 28.999...`），截断后就会出现「少一分」。
+
+const INVALID_FORMAT: &str = "金额格式无效";
+const OUT_OF_RANGE: &str = "金额超出 i64 范围";
+
+/// 把十进制金额文本解析为「分」。
+///
+/// 接受的形状（首尾空白会被去除）：
+/// - 可选的单个负号 `-`；
+/// - 至少一位整数数字；
+/// - 可选的 `.` 加 1 或 2 位小数。
+///
+/// 拒绝：正号、指数、非数字、空整数部分、空小数部分、超过两位小数。
+/// 全过程使用整数运算，支持 `i64` 分的完整范围，溢出返回错误而不是
+/// 截断、舍入、饱和或 panic。
 pub fn parse_cents(input: &str) -> Result<i64, String> {
-    let amount: f64 = input.trim().parse().map_err(|_| "金额无效".to_owned())?;
-    Ok((amount * 100.0) as i64)
+    let text = input.trim();
+
+    let (negative, unsigned) = match text.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, text),
+    };
+
+    let (integer, fraction) = match unsigned.split_once('.') {
+        Some((integer, fraction)) => (integer, Some(fraction)),
+        None => (unsigned, None),
+    };
+
+    if integer.is_empty() || !integer.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err(INVALID_FORMAT.to_owned());
+    }
+
+    // 小数部分：0、1 或 2 位数字，不足两位时补齐为分。
+    let fraction_cents: i128 = match fraction {
+        None => 0,
+        Some(digits) => {
+            if digits.is_empty()
+                || digits.len() > 2
+                || !digits.bytes().all(|byte| byte.is_ascii_digit())
+            {
+                return Err(INVALID_FORMAT.to_owned());
+            }
+            let mut value: i128 = 0;
+            for byte in digits.bytes() {
+                value = value * 10 + i128::from(byte - b'0');
+            }
+            if digits.len() == 1 {
+                value * 10
+            } else {
+                value
+            }
+        }
+    };
+
+    // 整数部分逐位累加，任何溢出（连同后续的范围检查）都是错误。
+    let mut cents: i128 = 0;
+    for byte in integer.bytes() {
+        cents = cents
+            .checked_mul(10)
+            .and_then(|value| value.checked_add(i128::from(byte - b'0')))
+            .ok_or_else(|| OUT_OF_RANGE.to_owned())?;
+    }
+    cents = cents
+        .checked_mul(100)
+        .and_then(|value| value.checked_add(fraction_cents))
+        .ok_or_else(|| OUT_OF_RANGE.to_owned())?;
+
+    if negative {
+        cents = -cents;
+    }
+
+    // 先取符号再判范围，`-92233720368547758.08` 因此能精确落在 i64::MIN。
+    i64::try_from(cents).map_err(|_| OUT_OF_RANGE.to_owned())
 }
 
+/// 把「分」格式化为固定两位小数的十进制文本。
+///
+/// 覆盖 `i64` 完整范围，负数保留负号（包括 `-0.01` 到 `-0.99` 这类
+/// 整数部分为 0 的情况），并且与 [`parse_cents`] 互为逆运算。
 pub fn format_cents(cents: i64) -> String {
