+            deposit("", "alice", 1),
+            deposit("bad id", "alice", 1),
+            deposit("d2", "", 1),
+            deposit("d2", "账 户", 1),
+            deposit("d2", "账户", 1),
+            deposit("d2", "alice", 0),
+            deposit("d2", "alice", -1),
+            transfer("t1", "alice", "alice", 1),      // 两端相同
+            transfer("t1", "alice", "missing", 1),    // 目标不存在
+            transfer("t1", "missing", "alice", 1),    // 源不存在
+            transfer("t1", "alice", "bob", 10_000),   // 余额不足
+            transfer("t1", "alice", "bob", 0),
