+
+fn parse_line(line: &str) -> Result<Event, String> {
+    let fields: Vec<&str> = line.split(',').map(str::trim).collect();
+    match fields.as_slice() {
+        ["deposit", id, account, amount] => {
+            validate_token(id, "请求ID")?;
+            validate_token(account, "账户名")?;
+            let cents = parse_cents(amount)?;
+            validate_cents(cents)?;
+            Ok(Event::Deposit {
+                id: (*id).to_owned(),
+                account: (*account).to_owned(),
+                cents,
+            })
+        }
+        ["transfer", id, from, to, amount] => {
+            validate_token(id, "请求ID")?;
+            validate_token(from, "源账户名")?;
+            validate_token(to, "目标账户名")?;
+            let cents = parse_cents(amount)?;
+            validate_cents(cents)?;
+            Ok(Event::Transfer {
+                id: (*id).to_owned(),
+                from: (*from).to_owned(),
+                to: (*to).to_owned(),
+                cents,
+            })
+        }
+        [kind, ..] if *kind == "deposit" || *kind == "transfer" => Err(format!(
+            "{kind} 需要 {} 个字段，实际得到 {} 个",
+            if *kind == "deposit" { 4 } else { 5 },
+            fields.len()
+        )),
+        [kind, ..] => Err(format!("不支持的流水类型：{kind}")),
+        [] => Err("空行".to_owned()),
+    }
+}
