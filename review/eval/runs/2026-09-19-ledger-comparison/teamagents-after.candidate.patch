+//! Exact conversion between decimal amount text and `i64` cents.
+//!
+//! Amounts are represented internally as a whole number of cents in an `i64`.
+//! Both directions are exact over the whole `i64` range: no floating point,
+//! no rounding, no saturation and no panic.
+
+const PARSE_ERR: &str = "金额格式非法：应为可选负号加至少一位整数，可选 1 到 2 位小数";
+const FRACTION_ERR: &str = "金额格式非法：小数部分必须是 1 或 2 位数字";
+const OVERFLOW_ERR: &str = "金额超出 i64 分的表示范围";
+
+/// Parse a decimal amount into an exact number of cents (`i64`).
+///
+/// Accepted forms: optional surrounding whitespace, an optional leading `-`,
+/// at least one integer digit and an optional fractional part of one or two
+/// digits (for example `-0.01`, `12`, `12.3`, ` 12.30 `). Rejected forms
+/// include a leading `+`, exponents, any non-digit character, an empty integer
+/// part, an empty fractional part, more than two fractional digits, and any
+/// value outside the `i64` cents range.
 pub fn parse_cents(input: &str) -> Result<i64, String> {
-    let amount: f64 = input.trim().parse().map_err(|_| "金额无效".to_owned())?;
-    Ok((amount * 100.0) as i64)
+    let text = input.trim();
+
+    let (negative, digits) = match text.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, text),
+    };
+
+    let (integer, fraction) = match digits.split_once('.') {
+        Some((integer, fraction)) => (integer, Some(fraction)),
+        None => (digits, None),
+    };
+
+    if integer.is_empty() || !integer.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err(PARSE_ERR.to_owned());
+    }
+
+    let fraction: &str = match fraction {
+        None => "",
+        Some(fraction) => {
+            if fraction.is_empty()
+                || fraction.len() > 2
+                || !fraction.bytes().all(|byte| byte.is_ascii_digit())
+            {
+                return Err(FRACTION_ERR.to_owned());
+            }
+            fraction
+        }
+    };
+
+    // The largest magnitude that any `i64` cent value can have: |i64::MIN|.
+    const LIMIT: i128 = i64::MAX as i128 + 1;
+
+    // Accumulate in `i128` so that no intermediate value can overflow, and bail
+    // out as soon as the magnitude cannot possibly fit into an `i64`.
+    let mut magnitude: i128 = 0;
+    for byte in integer.bytes() {
+        magnitude = magnitude * 10 + i128::from(byte - b'0');
+        if magnitude > LIMIT {
+            return Err(OVERFLOW_ERR.to_owned());
+        }
+    }
+    magnitude *= 100;
+    match fraction.as_bytes() {
+        [] => {}
+        [digit] => magnitude += i128::from(digit - b'0') * 10,
+        [first, second] => {
+            magnitude += i128::from(first - b'0') * 10 + i128::from(second - b'0');
+        }
+        // `fraction` was already checked to hold one or two ASCII digits.
+        _ => return Err(FRACTION_ERR.to_owned()),
+    }
+    if magnitude > LIMIT {
+        return Err(OVERFLOW_ERR.to_owned());
+    }
+
+    if !negative {
+        if magnitude == LIMIT {
+            return Err(OVERFLOW_ERR.to_owned());
+        }
+        return Ok(magnitude as i64);
+    }
+    if magnitude == LIMIT {
+        return Ok(i64::MIN);
+    }
+    Ok(-(magnitude as i64))
 }
 
+/// Render cents as a decimal string with exactly two fraction digits.
+///
+/// The sign is preserved, including for values such as `-0.01`, and the whole
+/// `i64` range is supported.
 pub fn format_cents(cents: i64) -> String {
-    format!("{}.{:02}", cents / 100, (cents % 100).abs())
+    let negative = cents < 0;
+    // `unsigned_abs` keeps `i64::MIN` representable without overflowing.
+    let magnitude = cents.unsigned_abs();
+    let units = magnitude / 100;
+    let fraction = magnitude % 100;
+    if negative {
+        format!("-{units}.{fraction:02}")
+    } else {
+        format!("{units}.{fraction:02}")
+    }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::{format_cents, parse_cents};
+
+    #[test]
+    fn parses_accepted_forms() {
+        assert_eq!(parse_cents("12"), Ok(1200));
+        assert_eq!(parse_cents("12.3"), Ok(1230));
+        assert_eq!(parse_cents("12.34"), Ok(1234));
+        assert_eq!(parse_cents("0"), Ok(0));
+        assert_eq!(parse_cents("0.01"), Ok(1));
+        assert_eq!(parse_cents("0.0"), Ok(0));
+        assert_eq!(parse_cents("-0.01"), Ok(-1));
+        assert_eq!(parse_cents("-12.34"), Ok(-1234));
+        assert_eq!(parse_cents("-0"), Ok(0));
+        assert_eq!(parse_cents("  -12.30\t\n"), Ok(-1230));
