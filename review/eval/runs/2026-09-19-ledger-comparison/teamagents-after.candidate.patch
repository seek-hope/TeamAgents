+    #[test]
+    fn rejects_malformed_forms() {
+        for bad in [
+            "", " ", "+12", "+0.01", "12.", ".5", "-", "-.5", "--1", "12.345", "1.2.3", "1e3",
+            "1E3", "abc", "1 2", "12a", "a12", "１２", "12,3", "0x10", "NaN", "inf", "1.-2", "-12-",
+        ] {
+            assert!(parse_cents(bad).is_err(), "expected {bad:?} to be rejected");
+        }
+    }
+
+    #[test]
+    fn handles_full_i64_range() {
+        assert_eq!(parse_cents("92233720368547758.07"), Ok(i64::MAX));
+        assert_eq!(parse_cents("-92233720368547758.08"), Ok(i64::MIN));
+
+        // Bare integer forms are major units, so these are 100x out of range.
+        assert!(parse_cents("9223372036854775807").is_err());
+        assert!(parse_cents("-9223372036854775808").is_err());
+        assert!(parse_cents("92233720368547758.08").is_err());
+        assert!(parse_cents("9223372036854775808").is_err());
+        assert!(parse_cents("-92233720368547758.09").is_err());
+        assert!(parse_cents("-9223372036854775809").is_err());
+        assert!(parse_cents("99999999999999999999999999").is_err());
+        assert!(parse_cents("-99999999999999999999999999").is_err());
+        assert!(parse_cents(&"9".repeat(400)).is_err());
+    }
+
+    #[test]
+    fn formats_with_two_digits_and_sign() {
+        assert_eq!(format_cents(0), "0.00");
+        assert_eq!(format_cents(1), "0.01");
+        assert_eq!(format_cents(-1), "-0.01");
+        assert_eq!(format_cents(1200), "12.00");
+        assert_eq!(format_cents(-1230), "-12.30");
+        assert_eq!(format_cents(5), "0.05");
+        assert_eq!(format_cents(-5), "-0.05");
+        assert_eq!(format_cents(i64::MAX), "92233720368547758.07");
+        assert_eq!(format_cents(i64::MIN), "-92233720368547758.08");
+    }
+
+    #[test]
+    fn round_trips_over_sampled_range() {
+        let mut values: Vec<i64> = vec![0, 1, -1, 99, -99, 100, -100, 12345, -12345];
+        values.extend([i64::MIN, i64::MIN + 1, i64::MAX - 1, i64::MAX, -i64::MAX, i64::MAX / 100, -i64::MAX / 100]);
+        let mut state: u64 = 0x9E3779B97F4A7C15;
+        for _ in 0..20_000 {
+            state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            values.push(state as i64);
+        }
+        for value in values {
+            let text = format_cents(value);
+            assert_eq!(parse_cents(&text), Ok(value), "round trip failed for {value} ({text})");
+        }
+    }
+}
