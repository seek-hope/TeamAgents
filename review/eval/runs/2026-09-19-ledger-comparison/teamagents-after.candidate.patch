+/// Ids and account names may only contain ASCII letters, digits, underscores
+/// and hyphens, and must not be empty.
+pub(crate) fn validate_token(value: &str, what: &str) -> Result<(), String> {
+    if value.is_empty()
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+    {
+        return Err(format!(
+            "{what}只能包含 ASCII 字母、数字、下划线和连字符，且不能为空"
+        ));
+    }
+    Ok(())
+}
