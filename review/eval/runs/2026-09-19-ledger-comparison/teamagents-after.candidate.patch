+        assert!(ledger.apply(&transfer("t1", "alice", "bob", 100)).is_err());
+        assert_eq!(ledger.balance("alice"), None);
+        assert_eq!(ledger.balance("bob"), None);
+
+        // A later retry with the same id still fails while nothing changed.
+        assert_eq!(ledger.apply(&deposit("d1", "alice", 500)), Ok(true));
+        assert!(ledger.apply(&transfer("t1", "alice", "bob", 100)).is_err());
+        assert_eq!(ledger.balance("alice"), Some(500));
+        assert_eq!(ledger.balance("bob"), None);
+
+        // Once the target exists the retry finally succeeds and the id is then
+        // reserved by the successful request.
+        assert_eq!(ledger.apply(&deposit("d2", "bob", 1)), Ok(true));
+        assert_eq!(ledger.apply(&transfer("t1", "alice", "bob", 100)), Ok(true));
+        assert_eq!(ledger.balance("alice"), Some(400));
+        assert_eq!(ledger.balance("bob"), Some(101));
+        assert_eq!(ledger.apply(&transfer("t1", "alice", "bob", 100)), Ok(false));
+    }
+
+    #[test]
+    fn failed_transfer_neither_debits_nor_creates_accounts() {
+        let mut ledger = Ledger::new();
+        assert_eq!(ledger.apply(&deposit("d1", "alice", 100)), Ok(true));
+
+        // Unknown target: the source must not be debited and the target must
+        // not spring into existence.
+        assert!(ledger.apply(&transfer("t1", "alice", "ghost", 50)).is_err());
+        assert_eq!(ledger.balance("alice"), Some(100));
+        assert_eq!(ledger.balance("ghost"), None);
+
+        // Same account on both sides.
+        assert!(ledger.apply(&transfer("t2", "alice", "alice", 50)).is_err());
+        assert_eq!(ledger.balance("alice"), Some(100));
+
+        // Insufficient funds.
+        assert!(ledger.apply(&transfer("t3", "alice", "bob", 101)).is_err());
+        assert_eq!(ledger.balance("alice"), Some(100));
+        assert_eq!(ledger.balance("bob"), None);
+
+        // A failed transfer must not have consumed its id: top up the source
+        // account and retry with the very same id.
+        assert_eq!(ledger.apply(&deposit("d2", "bob", 101)), Ok(true));
+        assert!(ledger.apply(&transfer("t3", "alice", "bob", 101)).is_err());
+        assert_eq!(ledger.apply(&deposit("d3", "alice", 1)), Ok(true));
+        assert_eq!(ledger.apply(&transfer("t3", "alice", "bob", 101)), Ok(true));
+        assert_eq!(ledger.balance("alice"), Some(0));
+        assert_eq!(ledger.balance("bob"), Some(202));
+    }
+
+    #[test]
+    fn rejects_structurally_invalid_events_without_side_effects() {
+        let mut ledger = Ledger::new();
+        for bad in [
+            deposit("", "alice", 100),
+            deposit("d 1", "alice", 100),
+            deposit("d1", "", 100),
+            deposit("d1", "al ice", 100),
+            deposit("d1", "账户", 100),
+            deposit("d1", "alice", 0),
+            deposit("d1", "alice", -100),
+            transfer("t1", "alice", "bob", 0),
+            transfer("t1", "alice", "bob", -5),
+            transfer("", "alice", "bob", 5),
+        ] {
+            assert!(ledger.apply(&bad).is_err(), "{bad:?} should be rejected");
+        }
+        assert!(ledger.balances().is_empty());
+        assert_eq!(ledger.apply(&deposit("d1", "alice", 100)), Ok(true));
+    }
+
+    #[test]
+    fn balance_overflow_is_rejected_and_leaves_state_alone() {
+        let mut ledger = Ledger::new();
+        assert_eq!(ledger.apply(&deposit("d1", "alice", i64::MAX)), Ok(true));
+        assert!(ledger.apply(&deposit("d2", "alice", 1)).is_err());
+        assert_eq!(ledger.balance("alice"), Some(i64::MAX));
+
+        assert_eq!(ledger.apply(&deposit("d3", "bob", i64::MAX)), Ok(true));
+        assert!(ledger.apply(&transfer("t1", "bob", "alice", 1)).is_err());
+        assert_eq!(ledger.balance("alice"), Some(i64::MAX));
+        assert_eq!(ledger.balance("bob"), Some(i64::MAX));
+
+        // A tiny deposit still works and does not overflow.
+        assert_eq!(ledger.apply(&deposit("d4", "carol", 1)), Ok(true));
+        assert!(ledger.apply(&transfer("t2", "carol", "carol2", 1)).is_err());
+        assert_eq!(ledger.balance("carol"), Some(1));
+    }
+
+    #[test]
+    fn zero_balance_accounts_may_receive_and_spend_exactly() {
+        let mut ledger = Ledger::new();
+        assert_eq!(ledger.apply(&deposit("d1", "a", 100)), Ok(true));
+        assert!(ledger.apply(&deposit("d2", "b", 0)).is_err());
+        assert_eq!(ledger.apply(&deposit("d2", "b", 1)), Ok(true));
+        assert_eq!(ledger.apply(&transfer("t1", "a", "b", 100)), Ok(true));
+        assert_eq!(ledger.balance("a"), Some(0));
+        assert_eq!(ledger.balance("b"), Some(101));
+    }
