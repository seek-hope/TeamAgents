+/// Fork support (worker `fork_session`): carry the session-scoped configuration
+/// that lives next to team.db — auto-created member profiles (D-30) and /model
+/// overrides (D-29) — into a new session. That is team config, not team facts.
+/// Must run before the new session opens: its members may name profiles that
+/// exist nowhere else.
+pub fn copy_session_config(source_session_id: &str, dest_session_id: &str) -> Result<(), String> {
+    let dest = session_paths(dest_session_id).base;
+    std::fs::create_dir_all(&dest).map_err(|e| e.to_string())?;
+    for name in ["profiles.json", "model_overrides.json"] {
+        let source = session_paths(source_session_id).base.join(name);
+        if !source.is_file() {
+            continue;
+        }
+        std::fs::copy(&source, dest.join(name)).map_err(|e| format!("fork {name}: {e}"))?;
+    }
+    Ok(())
+}
+
+/// Atomic write (tmp + rename) for the forked leader history files.
+fn write_json_atomic(path: &std::path::Path, value: &Json) -> Result<(), String> {
+    let parent = path.parent().ok_or("history parent missing")?;
+    std::fs::create_dir_all(parent).map_err(|e| e.to_string())?;
+    let tmp = path.with_extension("tmp");
+    std::fs::write(&tmp, value.to_string()).map_err(|e| e.to_string())?;
+    std::fs::rename(&tmp, path).map_err(|e| e.to_string())
+}
