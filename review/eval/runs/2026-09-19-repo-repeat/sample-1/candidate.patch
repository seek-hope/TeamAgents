+                "cwd": cwd.to_string_lossy(),
+                "resume": "proj_src",
+                "scripts": {"leader": [["end"]], "cod": [["end"]]},
+                "initial_spec": spec_with_session_profile(),
+            }))
+            .expect("open source");
+        assert_eq!(opened["session_id"], json!("proj_src"));
+
+        // /model override (D-29) on the leader
+        worker.handle("set_model", &json!({"agent_id": "leader", "profile": "other"})).expect("set_model");
+
+        // the Leader reset its context: the live thread is epoch 3, not 1
+        let conn = rusqlite::Connection::open(session_paths("proj_src").db).unwrap();
+        conn.execute("UPDATE agent_runtime SET context_epoch=3 WHERE session_id='proj_src' AND agent_id='leader'", []).unwrap();
+        drop(conn);
+        let live = json!({"nodes": [
+            {"id": "n1", "parent": null, "message": {"role": "user", "content": "u1"}},
+            {"id": "n2", "parent": "n1", "message": {"role": "assistant", "content": "a1"}},
+            {"id": "n3", "parent": "n1", "message": {"role": "assistant", "content": "branch"}},
+        ], "leaf": "n3"});
+        let member = source_base.join("members/leader");
+        std::fs::create_dir_all(&member).unwrap();
+        std::fs::write(member.join("chat_tree.json"), json!({"ctx:leader:3": live}).to_string()).unwrap();
+        std::fs::write(member.join("chat_history.json"), json!({"ctx:leader:3": [{"role": "user", "content": "u1"}]}).to_string()).unwrap();
+        let source_tree_bytes = std::fs::read_to_string(member.join("chat_tree.json")).unwrap();
+
+        let model_before = worker.handle("model", &json!({})).expect("model");
+        assert_eq!(model_before["agents"][1]["model"], json!("session-model"), "{model_before}");
+
+        let forked = worker.handle("fork_session", &json!({})).expect("fork");
+        let fork_id = forked["session_id"].as_str().unwrap().to_string();
+        assert_ne!(fork_id, "proj_src");
+        assert_eq!(forked["forked_from"], json!("proj_src"));
+
+        // session profiles (D-30) and /model overrides (D-29) are inherited
+        let fork_base = session_paths(&fork_id).base;
+        assert_eq!(
+            std::fs::read_to_string(fork_base.join("profiles.json")).unwrap(),
+            std::fs::read_to_string(source_base.join("profiles.json")).unwrap()
+        );
+        assert_eq!(
+            std::fs::read_to_string(fork_base.join("model_overrides.json")).unwrap(),
+            std::fs::read_to_string(source_base.join("model_overrides.json")).unwrap()
+        );
+        let model_after = worker.handle("model", &json!({})).expect("model");
+        assert_eq!(model_after["agents"], model_before["agents"], "{model_after}");
+
+        // the live thread is mapped onto the new session's own epoch; every
+        // branch, node and the leaf survive and the source file is untouched
+        let mapped: Json = serde_json::from_str(&std::fs::read_to_string(fork_base.join("members/leader/chat_tree.json")).unwrap()).unwrap();
+        assert_eq!(mapped["ctx:leader:1"], live, "{mapped}");
+        assert!(mapped.get("ctx:leader:3").is_none(), "the new session runs its own epoch: {mapped}");
+        let mapped_history: Json = serde_json::from_str(&std::fs::read_to_string(fork_base.join("members/leader/chat_history.json")).unwrap()).unwrap();
+        assert_eq!(mapped_history["ctx:leader:1"], json!([{"role": "user", "content": "u1"}]));
+        assert_eq!(std::fs::read_to_string(member.join("chat_tree.json")).unwrap(), source_tree_bytes);
+
+        // fresh team state: no tasks/runs came along
+        let state = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).expect("state");
+        assert!(state["tasks"].as_array().unwrap().is_empty(), "{state}");
+        assert!(state["runs"].as_array().unwrap().is_empty(), "{state}");
+
+        // ...and profile/model/effort survive reopening the forked session
+        worker.handle("open", &json!({"cwd": cwd.to_string_lossy(), "resume": fork_id})).expect("reopen fork");
+        let reopened = worker.handle("model", &json!({})).expect("model");
+        assert_eq!(reopened["agents"], model_before["agents"], "{reopened}");
+        worker.handle("close", &json!({})).expect("close");
+    }
+
+    #[test]
+    fn a_failed_open_or_switch_keeps_the_current_session() {
+        let (_env, root, cwd) = isolated("failed-open");
+        let team_path = root.join("team.json");
+        std::fs::write(&team_path, json!({
+            "leader_id": "leader",
+            "agents": [
+                {"id": "leader", "name": "Leader", "role": "leader", "runtime_kind": "deepagents",
+                 "model_profile": "leader_main"},
+                {"id": "mate", "name": "Mate", "role": "worker", "runtime_kind": "deepagents",
+                 "model_profile": "leader_main"},
+            ],
+            "shared_spaces": [{"id": "main", "readers": ["leader", "mate"], "writers": ["leader", "mate"]}],
+        }).to_string()).unwrap();
+
+        let worker = Worker::new();
+        worker
+            .handle("open", &json!({
+                "cwd": cwd.to_string_lossy(),
+                "resume": "proj_keep",
+                "team": team_path.to_string_lossy(),
+                "scripts": {"leader": [["end"]], "mate": [["end"]]},
+            }))
+            .expect("open");
+        let before = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).expect("state");
+        let model_before = worker.handle("model", &json!({})).expect("model");
+
+        // both a failed switch and a failed open must leave the old session alone
+        let err = worker.handle("switch_session", &json!({"session_id": "../evil"})).unwrap_err();
+        assert!(err.contains("invalid session id"), "{err}");
+        let err = worker.handle("open", &json!({"cwd": cwd.to_string_lossy(), "resume": "bad/id"})).unwrap_err();
+        assert!(err.contains("invalid session id"), "{err}");
+
+        let after = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).expect("state");
+        assert_eq!(after["session"]["session_id"], json!("proj_keep"));
+        assert_eq!(after["session"]["cwd"], before["session"]["cwd"], "cwd keeps its value");
+        assert_eq!(after["session"]["permissions_mode"], before["session"]["permissions_mode"]);
+        assert_eq!(worker.handle("model", &json!({})).expect("model")["agents"], model_before["agents"]);
+        let receipt = worker.handle("user_message", &json!({"text": "still here"})).expect("user_message");
+        assert_eq!(receipt["ok"], json!(true), "the old session still accepts work");
+
+        // the worker's team config survived too: a new session still starts
+        // from the configured team spec (2 members, not the 1-member default)
+        worker.handle("new_session", &json!({})).expect("new_session");
+        let fresh = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).expect("state");
+        assert_eq!(fresh["spec"]["agents"].as_array().unwrap().len(), 2, "{fresh}");
+        worker.handle("close", &json!({})).expect("close");
+    }
+
+    #[test]
+    fn a_failed_fork_cleans_the_target_and_keeps_the_source() {
+        let (_env, _root, cwd) = isolated("failed-fork");
+        let worker = Worker::new();
+        // (1) the fork's own open fails: the spec names a profile no user config
+        // knows. The scripted source tolerates it, a real runner does not.
+        worker
+            .handle("open", &json!({
+                "cwd": cwd.to_string_lossy(),
+                "resume": "proj_ghost",
+                "scripts": {"leader": [["end"]], "ghost": [["end"]]},
+                "initial_spec": json!({
+                    "leader_id": "leader",
+                    "agents": [
+                        {"id": "leader", "name": "Leader", "role": "leader", "runtime_kind": "deepagents",
+                         "model_profile": "leader_main"},
+                        {"id": "ghost", "name": "Ghost", "role": "worker", "runtime_kind": "deepagents",
+                         "model_profile": "ghost"},
+                    ],
+                    "shared_spaces": [{"id": "main", "readers": ["leader", "ghost"], "writers": ["leader"]}],
+                }),
+            }))
+            .expect("open ghost source");
+        let target = new_session_id(&cwd);
+        let err = worker.handle("fork_session", &json!({})).unwrap_err();
+        assert!(err.contains("ghost"), "{err}");
+        assert!(!session_paths(&target).base.exists(), "the half-open target is cleaned up");
+        let state = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).expect("state");
+        assert_eq!(state["session"]["session_id"], json!("proj_ghost"), "the source is still current");
+        assert!(session_paths("proj_ghost").base.join("team.db").is_file());
+
+        // (2) the fork opens but the leader history cannot be adopted: same cleanup
+        worker
+            .handle("open", &json!({
+                "cwd": cwd.to_string_lossy(),
+                "resume": "proj_plain",
+                "scripts": {"leader": [["end"]]},
+                "initial_spec": json!({
+                    "leader_id": "leader",
+                    "agents": [{"id": "leader", "name": "Leader", "role": "leader",
+                                "runtime_kind": "deepagents", "model_profile": "leader_main"}],
+                    "shared_spaces": [{"id": "main", "readers": ["leader"], "writers": ["leader"]}],
+                }),
+            }))
+            .expect("open plain source");
+        let member = session_paths("proj_plain").base.join("members/leader");
+        std::fs::create_dir_all(&member).unwrap();
+        std::fs::write(member.join("chat_tree.json"), "{not json").unwrap();
+        let target = new_session_id(&cwd);
+        let err = worker.handle("fork_session", &json!({})).unwrap_err();
+        assert!(err.contains("fork"), "{err}");
+        assert!(!session_paths(&target).base.exists(), "the failed target is cleaned up");
+        let state = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).expect("state");
+        assert_eq!(state["session"]["session_id"], json!("proj_plain"), "the source is still current");
+        assert!(!crate::config::sessions_dir().join("archived").exists(), "the source was never archived");
+        worker.handle("close", &json!({})).expect("close");
+    }
+
+    #[test]
+    fn fork_is_refused_while_a_turn_is_active() {
+        let (_env, _root, cwd) = isolated("busy-fork");
+        let worker = Worker::new();
+        worker
+            .handle("open", &json!({
+                "cwd": cwd.to_string_lossy(),
+                "resume": "proj_busy",
+                "scripts": {"leader": [["sleep", 3.0], ["end"]]},
+            }))
+            .expect("open");
+        worker.handle("user_message", &json!({"text": "hold the turn"})).expect("user_message");
+        assert!(wait_until(|| active_runs(&worker) > 0, 5_000), "the scripted turn became active");
+        let sessions_before = crate::config::sessions_dir().read_dir().map(|d| d.count()).unwrap_or(0);
+        let err = worker.handle("fork_session", &json!({})).unwrap_err();
+        assert!(err.contains("回合进行中"), "{err}");
+        let sessions_after = crate::config::sessions_dir().read_dir().map(|d| d.count()).unwrap_or(0);
+        assert_eq!(sessions_after, sessions_before, "the refused fork created nothing");
+
+        assert!(wait_until(|| active_runs(&worker) == 0, 10_000), "the turn finished");
+        let forked = worker.handle("fork_session", &json!({})).expect("fork after the turn");
+        assert_ne!(forked["session_id"], json!("proj_busy"));
+        worker.handle("close", &json!({})).expect("close");
+    }
