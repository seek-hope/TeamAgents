+        assert_eq!(leader["model"], json!("auto-pinned"), "the choice must survive a reopen: {leader}");
+        assert_eq!(leader["effort"], json!("low"));
+        assert_eq!(leader["overridden"], json!(true));
+        second.close();
+        let _ = std::fs::remove_dir_all(&root);
+    }
