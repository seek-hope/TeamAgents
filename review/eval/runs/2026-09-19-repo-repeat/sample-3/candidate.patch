+/// D-26 fork: seed a freshly allocated target session with the source's
+/// session-scoped model config before the target is opened. `profiles.json`
+/// (D-30 auto-created member profiles) and `model_overrides.json` (D-29
+/// `/model` choices) are copied verbatim, so a fork whose members resolve only
+/// through the source's auto profiles can open and its `model` report matches
+/// the source. The source files are only read.
+pub fn copy_session_model_config(source_id: &str, dest_id: &str) -> Result<(), String> {
+    let from = session_paths(source_id).base;
+    let to = session_paths(dest_id).base;
+    for name in ["profiles.json", "model_overrides.json"] {
+        let path = from.join(name);
+        if !path.is_file() {
+            continue;
+        }
+        std::fs::create_dir_all(&to).map_err(|e| format!("prepare fork target: {e}"))?;
+        std::fs::copy(&path, to.join(name)).map_err(|e| format!("copy {name} into fork: {e}"))?;
+    }
+    Ok(())
+}
+
+/// D-26 fork: copy the leader's conversation into the target, remapping the
+/// source's current thread `ctx:<leader>:<src_epoch>` onto the target's own
+/// thread `ctx:<leader>:<dst_epoch>`. The leader may have reset context, so the
+/// epochs can differ; the ongoing conversation must land on the thread the fork
+/// actually uses. Both the tree (`chat_tree.json`) and the legacy linear
+/// history (`chat_history.json`) follow the same mapping — nodes, branches and
+/// the leaf are copied verbatim and the source files are never modified.
+pub fn copy_leader_conversation(
+    source_id: &str,
+    dest_id: &str,
+    leader: &str,
+    src_epoch: i64,
+    dst_epoch: i64,
+) -> Result<(), String> {
+    let from = session_paths(source_id).base.join("members").join(leader);
+    let to = session_paths(dest_id).base.join("members").join(leader);
+    let src_thread = format!("ctx:{leader}:{src_epoch}");
+    let dst_thread = format!("ctx:{leader}:{dst_epoch}");
+    for name in ["chat_tree.json", "chat_history.json"] {
+        let path = from.join(name);
+        if !path.is_file() {
+            continue;
+        }
+        std::fs::create_dir_all(&to).map_err(|e| format!("prepare fork member dir: {e}"))?;
+        let text = std::fs::read_to_string(&path).map_err(|e| format!("read source {name}: {e}"))?;
+        let rewritten = match serde_json::from_str::<Json>(&text) {
+            Ok(Json::Object(mut threads)) => {
+                if src_thread != dst_thread {
+                    if let Some(current) = threads.remove(&src_thread) {
+                        // the current thread wins over any stale same-named one
+                        threads.insert(dst_thread.clone(), current);
+                    }
+                }
+                Json::Object(threads).to_string()
+            }
+            // never drop data we cannot parse: copy it through unchanged
+            _ => text,
+        };
+        std::fs::write(to.join(name), rewritten).map_err(|e| format!("write fork {name}: {e}"))?;
+    }
+    Ok(())
+}
