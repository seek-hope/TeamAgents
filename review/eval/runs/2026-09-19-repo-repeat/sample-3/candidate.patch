+        let _ = std::fs::remove_dir_all(&root);
+        let cwd = root.join("project");
+        std::fs::create_dir_all(&cwd).unwrap();
+        std::env::set_var("XDG_CONFIG_HOME", root.join("home/.config"));
+        std::env::set_var("XDG_STATE_HOME", root.join("home/.state"));
+
+        let dir = session_paths("proj_auto").base;
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(
+            profiles_path("proj_auto"),
+            json!({"leader": {"provider": "openai", "protocol": "openai", "model": "auto-leader"}}).to_string(),
+        )
