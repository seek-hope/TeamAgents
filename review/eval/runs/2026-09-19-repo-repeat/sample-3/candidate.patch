+                .unwrap_or_default()
+                .into_iter()
+                .find(|a| a["agent_id"] == json!("leader"))
+                .unwrap_or_else(|| panic!("leader in {report}"))
+        };
+
+        let first = open();
+        let leader = leader_model(&first);
+        assert_eq!(leader["model_profile"], json!("leader"), "{leader}");
+        assert_eq!(leader["model"], json!("auto-pinned"), "override must resolve the session profile: {leader}");
+        assert_eq!(leader["effort"], json!("low"));
+        assert_eq!(leader["overridden"], json!(true));
+        first.close();
+
+        let second = open();
