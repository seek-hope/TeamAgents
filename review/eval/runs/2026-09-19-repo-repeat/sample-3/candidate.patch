+            "agents": [{"id": "leader", "name": "Leader", "role": "leader", "runtime_kind": "deepagents",
+                        "model_profile": "leader", "tool_bindings": []}],
+            "shared_spaces": [{"id": "main", "readers": ["leader"], "writers": ["leader"]}],
