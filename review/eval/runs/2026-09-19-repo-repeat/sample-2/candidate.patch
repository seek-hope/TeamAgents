+/// the `/model` choices (D-29). Both are read during `open_session`, so a fork
+/// must write them into the target session *before* opening it.
+pub fn carry_session_config(source_session: &str, target_session: &str) -> Result<(), String> {
+    let source = session_paths(source_session).base;
+    let target = session_paths(target_session).base;
+    std::fs::create_dir_all(&target).map_err(|e| format!("create fork target {}: {e}", target.display()))?;
