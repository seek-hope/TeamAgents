+/// D-26 fork: copy the Leader's conversation to the new session, re-keyed from
+/// the source's thread (`ctx:<leader>:<source epoch>`) onto the target session's
+/// own thread (`ctx:<leader>:<target epoch>`).
+///
+/// The tree (every branch, node and the leaf pointer, verbatim) and the legacy
+/// linear history follow the same mapping: a session whose context was reset
+/// stores its current conversation under its own epoch, and the fork's leader
+/// starts a fresh epoch, so a plain file copy would land under a thread the new
+/// session never reads. An entry that would collide with the target thread is
+/// dropped — the current conversation owns that key. Source files are only read,
+/// never rewritten.
+pub fn carry_conversation(
+    source_session: &str,
+    target_session: &str,
+    leader: &str,
+    source_thread: &str,
+    target_thread: &str,
+) -> Result<(), String> {
+    let source = session_paths(source_session).base.join("members").join(leader);
+    let target = session_paths(target_session).base.join("members").join(leader);
+    std::fs::create_dir_all(&target).map_err(|e| format!("create {}: {e}", target.display()))?;
+    for name in ["chat_tree.json", "chat_history.json"] {
+        let from = source.join(name);
+        if !from.is_file() {
+            continue;
+        }
+        let text = std::fs::read_to_string(&from).map_err(|e| format!("read {}: {e}", from.display()))?;
+        let parsed: Json = serde_json::from_str(&text).map_err(|e| format!("invalid {name} in source session: {e}"))?;
+        let threads = parsed.as_object().ok_or_else(|| format!("invalid {name} in source session: not an object"))?;
+        let mut remapped = serde_json::Map::new();
+        if let Some(current) = threads.get(source_thread) {
+            remapped.insert(target_thread.to_string(), current.clone());
+        }
+        for (thread, tree) in threads {
+            if thread == source_thread {
+                continue;
+            }
+            remapped.entry(thread.clone()).or_insert_with(|| tree.clone());
+        }
+        let path = target.join(name);
+        let tmp = target.join(format!("{name}.tmp"));
+        let text = serde_json::to_string_pretty(&Json::Object(remapped)).map_err(|e| e.to_string())?;
+        std::fs::write(&tmp, text)
+            .and_then(|_| std::fs::rename(&tmp, &path))
+            .map_err(|e| format!("write {}: {e}", path.display()))?;
+    }
+    Ok(())
 }
 
