+            "ctx:leader:1": [{"role": "user", "content": "pre-reset"}],
+        });
+        std::fs::create_dir_all(leader_dir("proj_src")).unwrap();
+        std::fs::write(leader_dir("proj_src").join("chat_tree.json"), serde_json::to_string(&tree).unwrap()).unwrap();
+        std::fs::write(leader_dir("proj_src").join("chat_history.json"), serde_json::to_string(&history).unwrap()).unwrap();
+        set_context_epoch(&source_dir.join("team.db"), "proj_src", "leader", 3);
+        let tree_before = std::fs::read(leader_dir("proj_src").join("chat_tree.json")).unwrap();
+        let history_before = std::fs::read(leader_dir("proj_src").join("chat_history.json")).unwrap();
+
+        let forked = worker.handle("fork_session", &json!({})).expect("fork");
+        let forked_id = forked["session_id"].as_str().unwrap().to_string();
+        assert_ne!(forked_id, "proj_src");
+        assert_eq!(forked["forked_from"], json!("proj_src"));
+        assert_eq!(current(&worker), forked_id);
+
+        // model report: profile, model and effort are the source's
+        assert_eq!(
+            effective(&worker.handle("model", &json!({})).unwrap(), "leader"),
+            source_leader,
+            "the fork inherits the session-only profile and the /model override"
+        );
+
+        // conversation: current thread re-keyed, all branches/nodes/leaf kept
+        let forked_tree: Json =
+            serde_json::from_str(&std::fs::read_to_string(leader_dir(&forked_id).join("chat_tree.json")).unwrap()).unwrap();
+        assert_eq!(forked_tree["ctx:leader:1"], tree["ctx:leader:3"]);
+        let forked_history: Json =
+            serde_json::from_str(&std::fs::read_to_string(leader_dir(&forked_id).join("chat_history.json")).unwrap()).unwrap();
+        assert_eq!(forked_history["ctx:leader:1"], history["ctx:leader:3"]);
+        let points = worker.handle("rewind_points", &json!({})).unwrap();
+        assert_eq!(points["thread"], json!("ctx:leader:1"));
+        assert_eq!(points["points"][0]["id"], json!("n4"), "{points}");
+        assert_eq!(points["points"][1]["id"], json!("n2"), "the abandoned branch stays in the tree: {points}");
+
+        // the source session's files are untouched
+        assert_eq!(std::fs::read(leader_dir("proj_src").join("chat_tree.json")).unwrap(), tree_before);
+        assert_eq!(std::fs::read(leader_dir("proj_src").join("chat_history.json")).unwrap(), history_before);
+
+        // team state is fresh: no runs/tasks came along
+        let state = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).unwrap();
+        assert_eq!(state["runs"].as_array().map(Vec::len), Some(0), "{state}");
+        assert_eq!(state["tasks"].as_array().map(Vec::len), Some(0), "{state}");
+
+        // both sessions reopen with the same effective model (config persists)
+        worker.handle("switch_session", &json!({"session_id": "proj_src"})).expect("source reopens");
+        assert_eq!(effective(&worker.handle("model", &json!({})).unwrap(), "leader")["model"], json!("gpt-5"));
+        worker.handle("switch_session", &json!({"session_id": forked_id})).expect("fork reopens");
+        assert_eq!(effective(&worker.handle("model", &json!({})).unwrap(), "leader"), source_leader);
+
+        worker.handle("close", &json!({})).unwrap();
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    /// fork is refused while any member has a QUEUED/RUNNING turn — the source
+    /// keeps running to completion, nothing is cancelled to force the fork.
+    #[test]
+    fn fork_is_refused_while_a_member_turn_is_active() {
+        let (_env, root) = isolate("fork-busy");
+        let cwd = root.join("project");
+        std::fs::create_dir_all(&cwd).unwrap();
+        let worker = Worker::new();
+        worker
+            .handle("open", &json!({
+                "cwd": cwd.to_string_lossy(),
+                "scripts": {"leader": [["sleep", 2.0], ["end"]]},
+            }))
+            .expect("open");
+        let source = current(&worker);
+        worker.handle("user_message", &json!({"text": "go"})).unwrap();
+
+        let busy = wait_for_state(&worker, |state| active_run(state));
+        assert!(busy, "the leader turn is running");
+        let err = worker.handle("fork_session", &json!({})).expect_err("busy fork");
+        assert!(err.contains("回合进行中"), "{err}");
+        assert_eq!(current(&worker), source, "the failed fork must not switch sessions");
+
+        // the turn runs to completion: the refusal did not cancel the member
+        assert!(wait_for_state(&worker, |state| !active_run(state)), "the turn finished");
+        let state = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).unwrap();
+        let leader_run = state["runs"]
+            .as_array()
+            .cloned()
+            .unwrap_or_default()
+            .into_iter()
+            .find(|r| r["agent_id"] == json!("leader"))
+            .expect("leader run");
+        assert_eq!(leader_run["status"], json!("COMPLETED"), "{leader_run}");
+
+        let forked = worker.handle("fork_session", &json!({})).expect("fork once idle");
+        assert_eq!(forked["forked_from"], json!(source));
+        worker.handle("close", &json!({})).unwrap();
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    /// A failed open/switch/fork never costs the running session: the previous
+    /// session stays current and usable, and a failed fork leaves no target
+    /// directory behind (its source is neither deleted nor archived).
+    #[test]
+    fn failed_open_and_fork_keep_the_source_session_usable() {
+        let (_env, root) = isolate("fork-fail");
+        let cwd = root.join("project");
+        std::fs::create_dir_all(&cwd).unwrap();
+        let worker = Worker::new();
+        // scripted so the open itself succeeds despite the unusable profile
+        let opened = worker
+            .handle("open", &json!({
+                "cwd": cwd.to_string_lossy(),
+                "resume": "proj_src",
+                "initial_spec": json!({
+                    "leader_id": "leader",
+                    "agents": [{"id": "leader", "name": "Leader", "role": "leader",
+                                "runtime_kind": "deepagents", "model_profile": "ghost"}],
+                    "shared_spaces": [{"id": "main", "readers": ["leader"], "writers": ["leader"]}],
+                }),
+                "scripts": {"leader": [["end"]]},
+            }))
+            .expect("open");
+        assert_eq!(opened["session_id"], json!("proj_src"));
+        let source_cwd = worker.cwd.lock().unwrap().clone();
+
+        // the fork cannot build its member runner (no scripts): its target must
+        // be cleaned up and the source session left exactly where it was
+        let err = worker.handle("fork_session", &json!({})).expect_err("fork must fail");
+        assert!(err.contains("unknown model profile"), "{err}");
+        assert_eq!(current(&worker), "proj_src", "the source session stays current");
+        assert_eq!(worker.cwd.lock().unwrap().clone(), source_cwd);
+        let roots: Vec<String> = std::fs::read_dir(crate::config::sessions_dir())
+            .unwrap()
+            .flatten()
+            .map(|e| e.file_name().to_string_lossy().into_owned())
+            .collect();
+        assert_eq!(roots, vec!["proj_src".to_string()], "a failed fork leaves no half-created session");
+        assert!(session_paths("proj_src").db.exists(), "the source session survives");
+
+        // the same holds for a failed `open` and a failed `switch_session`
+        assert!(worker.handle("open", &json!({"cwd": cwd.to_string_lossy(), "team": "/nope/spec.json"})).is_err());
+        assert!(worker.handle("switch_session", &json!({"session_id": "../evil"})).is_err());
+        assert_eq!(current(&worker), "proj_src");
+        assert_eq!(worker.cwd.lock().unwrap().clone(), source_cwd, "cwd and permission mode survive");
+        let report = worker.handle("model", &json!({})).unwrap();
+        assert_eq!(effective(&report, "leader")["model_profile"], json!("ghost"), "{report}");
+
+        worker.handle("close", &json!({})).unwrap();
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    fn active_run(state: &Json) -> bool {
+        state["runs"]
+            .as_array()
+            .cloned()
+            .unwrap_or_default()
+            .into_iter()
+            .any(|r| matches!(r["status"].as_str(), Some("QUEUED") | Some("RUNNING")))
+    }
+
+    fn wait_for_state(worker: &Worker, predicate: impl Fn(&Json) -> bool) -> bool {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(20);
+        while std::time::Instant::now() < deadline {
+            if let Ok(state) = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})) {
+                if predicate(&state) {
+                    return true;
+                }
+            }
+            std::thread::sleep(std::time::Duration::from_millis(50));
+        }
+        false
+    }
+}
