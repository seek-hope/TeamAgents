+        assert_eq!(leader["effort"], json!("high"));
+        assert_eq!(leader["overridden"], json!(true));
+        let target_member = session_paths(&target).base.join("members/leader");
+        let forked_tree: Json = serde_json::from_slice(&std::fs::read(target_member.join("chat_tree.json")).unwrap()).unwrap();
+        assert_eq!(forked_tree["ctx:leader:1"], tree["ctx:leader:3"], "all nodes, branches and the leaf moved");
+        assert_eq!(forked_tree["ctx:leader:3"], Json::Null, "the later epoch is not carried over as-is");
+        let forked_history: Json = serde_json::from_slice(&std::fs::read(target_member.join("chat_history.json")).unwrap()).unwrap();
+        assert_eq!(forked_history["ctx:leader:1"], history["ctx:leader:3"], "linear history maps the same way");
+        // team facts do not travel with a fork
+        let state = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).unwrap();
+        assert!(state["tasks"].as_array().unwrap().is_empty(), "{state}");
+        assert!(state["runs"].as_array().unwrap().is_empty(), "{state}");
+
+        // and a reopen still reports the same profile, model and effort
+        worker.handle("close", &json!({})).unwrap();
+        worker
+            .handle("open", &json!({"cwd": cwd.to_string_lossy(), "resume": target}))
+            .expect("reopen the fork");
+        let reopened = leader_of(&worker.handle("model", &json!({})).unwrap());
+        assert_eq!(reopened["model_profile"], json!("auto1"));
+        assert_eq!(reopened["model"], json!("gpt-5"));
+        assert_eq!(reopened["effort"], json!("high"));
+        worker.handle("close", &json!({})).unwrap();
+        let _ = std::fs::remove_dir_all(cwd.parent().unwrap());
+    }
+
+    /// A switch or fork that cannot open its target leaves the live session —
+    /// its cwd, team and permission mode included — exactly as it was.
+    #[test]
+    fn a_failed_switch_or_fork_keeps_the_current_session_alive() {
+        let (_env, cwd) = isolate("fork-keep");
+        let worker = Worker::new();
+        write_auto_profile("keep_src");
+        worker
+            .handle("open", &json!({"cwd": cwd.to_string_lossy(), "resume": "keep_src", "fullAuto": true,
+                                    "initial_spec": auto_spec()}))
+            .expect("open");
+        let current = "keep_src";
+        let state = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).unwrap();
+        assert_eq!(state["session"]["permissions_mode"], json!("full_auto"));
+        let session_cwd = json!(std::fs::canonicalize(&cwd).unwrap().to_string_lossy().into_owned());
+
+        // a session another process holds must not be switched to
+        let held = crate::sessions::acquire_session_lock("keep_busy").unwrap();
+        let error = worker
+            .handle("switch_session", &json!({"session_id": "keep_busy"}))
+            .err()
+            .expect("a locked session is refused");
+        assert!(error.contains("already running"), "{error}");
+        drop(held);
+        let state = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).unwrap();
+        assert_eq!(state["session"]["session_id"], json!(current), "the live session survived");
+        assert_eq!(state["session"]["cwd"], session_cwd, "its working directory is unchanged");
+        assert_eq!(state["session"]["permissions_mode"], json!("full_auto"), "its permission mode is unchanged");
+
+        // a fork whose own open fails (a config that stopped parsing after the
+        // source session started) leaves no half-built target behind
+        let target = new_session_id(&cwd);
+        let before = session_dirs();
+        let config = crate::config::user_config_path();
+        std::fs::write(&config, "not = = toml\n").unwrap();
+        let error = worker.handle("fork_session", &json!({})).err().expect("the broken config fails the fork");
+        assert!(error.contains("bad TOML"), "{error}");
+        assert_eq!(session_dirs(), before, "no half-built target directory is left behind");
+        assert!(!session_paths(&target).base.exists(), "the incomplete target directory is cleaned up");
+        std::fs::write(&config, "[models.leader_main]\nprovider='openai'\nprotocol='openai'\nmodel='configured'\n")
+            .unwrap();
+        let state = worker.handle("call", &json!({"method": "state", "params": {"include_events": false}})).unwrap();
+        assert_eq!(state["session"]["session_id"], json!(current), "the source session is still the live one");
+        assert_eq!(state["session"]["permissions_mode"], json!("full_auto"));
+        assert!(session_paths(current).db.exists(), "the source session is neither archived nor deleted");
+        // switching to the session that is already open is a no-op, not a self-lock
+        let same = worker.handle("switch_session", &json!({"session_id": current})).expect("switch to self");
+        assert_eq!(same["session_id"], json!(current));
+        // ...and the source session can still be forked now that the config parses
+        let forked = worker.handle("fork_session", &json!({})).expect("fork after the config was repaired");
+        assert_eq!(forked["forked_from"], json!(current));
+        assert!(session_paths(current).db.exists(), "forking does not touch the source session");
+        worker.handle("close", &json!({})).unwrap();
+        let _ = std::fs::remove_dir_all(cwd.parent().unwrap());
+    }
+
+    /// Fork is refused while any member has a queued/running turn, and the
+    /// refusal never cancels that turn.
+    #[test]
+    fn fork_is_refused_while_a_member_turn_is_active() {
+        let (_env, cwd) = isolate("fork-busy");
+        let worker = Worker::new();
+        worker
+            .handle("open", &json!({"cwd": cwd.to_string_lossy(), "resume": "busy_src",
+                                    "scripts": {"leader": [["sleep", 2.0], ["end"]]}}))
+            .expect("open");
+        worker.handle("user_message", &json!({"text": "go"})).expect("user_message");
+        let running = || {
+            worker
+                .handle("call", &json!({"method": "state", "params": {"include_events": false}}))
+                .ok()
+                .map(|state| {
+                    state["runs"]
+                        .as_array()
+                        .cloned()
+                        .unwrap_or_default()
+                        .iter()
+                        .any(|run| run["status"] == json!("RUNNING"))
+                })
+                .unwrap_or(false)
+        };
+        assert!(wait_for(&mut running.clone(), 5000), "the leader turn started");
+        let error = worker.handle("fork_session", &json!({})).err().expect("a busy team refuses the fork");
+        assert!(error.contains("回合进行中"), "{error}");
+        assert!(running(), "the in-flight turn was left alone");
+        assert_eq!(worker.handle("model", &json!({})).unwrap()["session_id"], json!("busy_src"));
+        worker.handle("close", &json!({})).unwrap();
+        let _ = std::fs::remove_dir_all(cwd.parent().unwrap());
+    }
+}
