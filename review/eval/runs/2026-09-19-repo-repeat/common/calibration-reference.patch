+/// D-26 fork, first half: the session-scoped model state a fork inherits — the
+/// auto-created member profiles (D-30) and the `/model` overrides (D-29). It
+/// must be on disk *before* the target session opens: a member whose profile
+/// only exists in the source session resolves its model while opening, so a
+/// fork without these files fails with "unknown model profile". The source
+/// session is only read.
+pub fn copy_fork_model_state(source_id: &str, target_id: &str) -> Result<(), String> {
+    let mut created = false;
+    for (from, to) in [
+        (profiles_path(source_id), profiles_path(target_id)),
+        (overrides_path(source_id), overrides_path(target_id)),
+    ] {
+        if !from.is_file() {
+            continue;
+        }
+        if !created {
+            std::fs::create_dir_all(session_paths(target_id).base).map_err(|e| format!("fork target: {e}"))?;
+            created = true;
+        }
+        std::fs::copy(&from, &to).map_err(|e| format!("fork {}: {e}", from.display()))?;
+    }
+    Ok(())
+}
+
+/// D-26 fork, second half: the Leader's conversation — its history tree and a
+/// legacy linear `chat_history.json`. The source keeps it under
+/// `ctx:<leader>:<source epoch>` while the target opened its own epoch, so the
+/// live thread is moved to `target_thread`; every branch, node and the leaf
+/// travel with it. Team facts (tasks, runs, shared entries), other members'
+/// private history and execution state are not copied, and the source files are
+/// never modified.
+pub fn copy_fork_leader_history(
+    source_id: &str,
+    target_id: &str,
+    leader_id: &str,
+    source_thread: &str,
+    target_thread: &str,
+) -> Result<(), String> {
+    let from = session_paths(source_id).base.join("members").join(leader_id);
+    let to = session_paths(target_id).base.join("members").join(leader_id);
+    for name in ["chat_tree.json", "chat_history.json"] {
+        let source = from.join(name);
+        if !source.is_file() {
+            continue;
+        }
+        std::fs::create_dir_all(&to).map_err(|e| format!("fork target: {e}"))?;
+        copy_live_thread(&source, &to.join(name), source_thread, target_thread)?;
+    }
+    Ok(())
+}
+
+/// Copy one history file with the live thread stored under `target_thread`.
+/// Threads the source no longer uses are copied as they are; an unparseable
+/// file is copied verbatim (best effort — a fork must not fail on a history the
+/// source itself could not use either).
+fn copy_live_thread(source: &std::path::Path, target: &std::path::Path, source_thread: &str, target_thread: &str) -> Result<(), String> {
+    let bytes = std::fs::read(source).map_err(|e| format!("fork {}: {e}", source.display()))?;
+    let mapped = if source_thread == target_thread {
+        None
+    } else {
+        serde_json::from_slice::<Json>(&bytes).ok().filter(Json::is_object).and_then(|mut data| {
+            let value = data.as_object_mut()?.remove(source_thread)?;
+            data.as_object_mut()?.insert(target_thread.to_string(), value);
+            serde_json::to_vec(&data).ok()
+        })
+    };
+    std::fs::write(target, mapped.as_deref().unwrap_or(&bytes)).map_err(|e| format!("fork {}: {e}", target.display()))
+}
