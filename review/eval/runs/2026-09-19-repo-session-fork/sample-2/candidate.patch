+/// D-26 fork: copy the model state and the Leader conversation of
+/// `src_session_id` into the brand-new session `dst_session_id`.
+///
+/// Only what a fork is supposed to inherit crosses the boundary: session-level
+/// `profiles.json` (the auto-created member profiles, which exist in no other
+/// session) and the `/model` `model_overrides.json`, plus the Leader's
+/// conversation — the thread tree (`chat_tree.json`) and the pre-tree linear
+/// history (`chat_history.json`). The new session keeps no tasks, runs, shared
+/// facts, member-private history or shell state, and project work files are
+/// never copied or rolled back. Source files are only read.
+///
+/// A conversation is stored per thread (`ctx:<agent>:<epoch>`), so the source's
+/// current thread is mapped onto `dst_epoch` and the destination continues the
+/// source's conversation under its own epoch. Every source thread is kept as-is
+/// and payloads are copied verbatim, so all branches, nodes and the leaf
+/// pointer survive the mapping.
+///
+/// Called twice per fork: once before the new session boots (with
+/// `dst_epoch == src_epoch`, so `profiles.json` already exists when the copied
+/// TeamSpec is validated) and once with the destination's real epoch.
+pub fn fork_session_state(
+    src_session_id: &str,
+    dst_session_id: &str,
+    leader: &str,
+    src_epoch: i64,
+    dst_epoch: i64,
+) -> Result<(), String> {
+    let src_base = session_paths(src_session_id).base;
+    let dst_base = session_paths(dst_session_id).base;
+    std::fs::create_dir_all(&dst_base).map_err(|e| format!("create forked session dir: {e}"))?;
+    for name in ["profiles.json", "model_overrides.json"] {
+        let Ok(text) = std::fs::read_to_string(src_base.join(name)) else { continue };
+        std::fs::write(dst_base.join(name), text).map_err(|e| format!("copy {name}: {e}"))?;
+    }
+    let src_member = src_base.join("members").join(leader);
+    let dst_member = dst_base.join("members").join(leader);
+    for name in ["chat_tree.json", "chat_history.json"] {
+        let Ok(text) = std::fs::read_to_string(src_member.join(name)) else { continue };
+        let mapped = remap_conversation_thread(&text, leader, src_epoch, dst_epoch)
+            .map_err(|e| format!("{name}: {e}"))?;
+        std::fs::create_dir_all(&dst_member).map_err(|e| format!("create forked member dir: {e}"))?;
+        std::fs::write(dst_member.join(name), mapped).map_err(|e| format!("copy {name}: {e}"))?;
+    }
+    Ok(())
+}
+
+/// `{thread: payload}` conversation file (tree or linear history) rewritten for
+/// the fork target: the source's current thread becomes the destination's own
+/// thread, and every other thread of the source is kept as it is. A file
+/// without the source's current thread, or a fork that keeps the same epoch,
+/// passes through unchanged.
+fn remap_conversation_thread(
+    text: &str,
+    leader: &str,
+    src_epoch: i64,
+    dst_epoch: i64,
+) -> Result<String, String> {
+    if src_epoch == dst_epoch {
+        return Ok(text.to_string());
+    }
+    let mut value: Json = serde_json::from_str(text).map_err(|e| format!("invalid conversation: {e}"))?;
+    let Some(threads) = value.as_object_mut() else {
+        return Err("invalid conversation: not an object".to_string());
+    };
+    let Some(payload) = threads.remove(&format!("ctx:{leader}:{src_epoch}")) else {
+        return Ok(text.to_string());
+    };
+    threads.insert(format!("ctx:{leader}:{dst_epoch}"), payload);
+    serde_json::to_string_pretty(&value).map_err(|e| format!("invalid conversation: {e}"))
 }
 
