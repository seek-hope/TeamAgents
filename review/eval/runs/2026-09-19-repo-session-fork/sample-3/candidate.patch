+    #[test]
+    fn fork_conversation_rekeys_the_leaders_thread() {
+        // D-26: a fork keeps the whole tree/linear history but has to move it
+        // onto the new session's own `ctx:<leader>:<epoch>` thread, leaving the
+        // source files untouched.
+        let _env = crate::env_lock();
+        let root = std::env::temp_dir().join(format!("ta-fork-thread-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::env::set_var("XDG_STATE_HOME", root.join("state"));
+        std::env::set_var("XDG_CONFIG_HOME", root.join("config"));
+
+        let src_dir = session_paths("s-src").base.join("members").join("leader");
+        std::fs::create_dir_all(&src_dir).unwrap();
+        let tree = json!({
+            "ctx:leader:1": {"nodes": [{"id": "stale"}]},
+            "ctx:leader:2": {"nodes": [{"id": "u1"}, {"id": "u2"}], "leaf": "u2"},
+        });
+        std::fs::write(src_dir.join("chat_tree.json"), tree.to_string()).unwrap();
+        std::fs::write(
+            src_dir.join("chat_history.json"),
+            json!({"ctx:leader:2": [{"role": "user", "content": "hi"}]}).to_string(),
+        )
+        .unwrap();
+        let before = std::fs::read_to_string(src_dir.join("chat_tree.json")).unwrap();
+
+        fork_leader_conversation("s-src", "s-dst", "leader", "ctx:leader:2", "ctx:leader:1").unwrap();
+
+        let dst_dir = session_paths("s-dst").base.join("members").join("leader");
+        let copied: Json =
+            serde_json::from_str(&std::fs::read_to_string(dst_dir.join("chat_tree.json")).unwrap()).unwrap();
+        // the current thread wins over the stale entry of the new epoch; every
+        // node and the leaf survive
+        assert_eq!(copied["ctx:leader:1"], tree["ctx:leader:2"]);
+        assert!(copied.get("ctx:leader:2").is_none(), "{copied}");
+        let history: Json =
+            serde_json::from_str(&std::fs::read_to_string(dst_dir.join("chat_history.json")).unwrap()).unwrap();
+        assert_eq!(history["ctx:leader:1"][0]["content"], "hi");
+        // the source session is only read
+        assert_eq!(before, std::fs::read_to_string(src_dir.join("chat_tree.json")).unwrap());
+
+        // same epoch on both sides: inherited verbatim
+        fork_leader_conversation("s-src", "s-dst", "leader", "ctx:leader:2", "ctx:leader:2").unwrap();
+        let verbatim = std::fs::read_to_string(dst_dir.join("chat_tree.json")).unwrap();
+        assert!(verbatim.contains("stale"), "{verbatim}");
+        let _ = std::fs::remove_dir_all(&root);
+    }
