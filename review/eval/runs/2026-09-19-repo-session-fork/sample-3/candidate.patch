+/// Session-scoped model config (`profiles.json` + `model_overrides.json`) is
+/// part of what the conversation was configured with, so a fork inherits both
+/// files. They have to be in place before the new session boots, because
+/// `open_session` reads them while bootstrapping (D-26/D-29/D-30).
+pub fn copy_session_model_config(src_session_id: &str, dst_session_id: &str) -> Result<(), String> {
+    let dst = session_paths(dst_session_id).base;
+    for src in [profiles_path(src_session_id), overrides_path(src_session_id)] {
+        if !src.is_file() {
+            continue;
+        }
+        std::fs::create_dir_all(&dst).map_err(|e| format!("fork: {}: {e}", dst.display()))?;
+        let target = dst.join(src.file_name().unwrap_or_default());
+        std::fs::copy(&src, &target).map_err(|e| format!("fork {}: {e}", src.display()))?;
+    }
+    Ok(())
+}
+
+/// Copy the Leader's conversation into a freshly forked session: the chat tree
+/// and the (linear) history move from the source thread onto the new session's
+/// own `ctx:<leader>:<epoch>` thread, keeping every branch, node and leaf. The
+/// source files are only read — a fork never rewrites them (D-26).
+pub fn fork_leader_conversation(
+    src_session_id: &str,
+    dst_session_id: &str,
+    leader: &str,
+    src_thread: &str,
+    dst_thread: &str,
+) -> Result<(), String> {
+    let src_dir = session_paths(src_session_id).base.join("members").join(leader);
+    let dst_dir = session_paths(dst_session_id).base.join("members").join(leader);
+    for name in ["chat_tree.json", "chat_history.json"] {
+        let src = src_dir.join(name);
+        if !src.is_file() {
+            continue;
+        }
+        std::fs::create_dir_all(&dst_dir).map_err(|e| format!("fork: {}: {e}", dst_dir.display()))?;
+        let dst = dst_dir.join(name);
+        if src_thread == dst_thread {
+            // same thread name: the conversation is inherited verbatim
+            std::fs::copy(&src, &dst).map_err(|e| format!("fork {}: {e}", src.display()))?;
+            continue;
+        }
+        let Ok(text) = std::fs::read_to_string(&src) else { continue };
+        let Ok(parsed) = serde_json::from_str::<Json>(&text) else { continue };
+        let mapped = match parsed {
+            // thread-keyed store: the source thread wins over a stale entry that
+            // happens to carry the destination session's epoch
+            Json::Object(mut threads) => {
+                if let Some(messages) = threads.remove(src_thread) {
+                    threads.insert(dst_thread.to_string(), messages);
+                }
+                Json::Object(threads)
+            }
+            // legacy linear history: the whole file is the leader's conversation
+            other => json!({ dst_thread: other }),
+        };
+        let text = serde_json::to_string(&mapped).map_err(|e| e.to_string())?;
+        std::fs::write(&dst, text).map_err(|e| format!("fork {}: {e}", dst.display()))?;
+    }
+    Ok(())
+}
