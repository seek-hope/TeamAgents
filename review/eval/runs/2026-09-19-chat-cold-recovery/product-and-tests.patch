+    assert!(state["events"].to_string().contains("RECOVERED_COMPLETION"));
+    assert_eq!(std::fs::read_to_string(env.join("project/effect.txt")).unwrap(), "once\n");
+    model.assert_quiet();
+    resumed.close();
