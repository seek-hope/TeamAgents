+                    "scripts": {"leader": [["end"]]},
+                    "initial_spec": {
+                        "leader_id": "leader",
+                        "agents": [
+                            {"id": "leader", "name": "Leader", "role": "leader",
+                             "runtime_kind": "deepagents", "model_profile": "auto_leader", "tool_bindings": []},
+                            {"id": "dev", "name": "Dev", "role": "dev",
+                             "runtime_kind": "deepagents", "model_profile": "auto_dev", "tool_bindings": []}
+                        ],
+                        "shared_spaces": [{"id": "main", "readers": ["leader"], "writers": ["leader"]}],
+                    },
+                }),
+            )
+            .expect("open a session whose profile only lives in profiles.json");
+        assert_eq!(opened["session_id"], json!(source));
+        worker
+            .handle("set_model", &json!({"agent_id": "leader", "profile": "auto_leader", "effort": "high"}))
+            .expect("set_model leader");
+        worker
+            .handle("set_model", &json!({"agent_id": "dev", "profile": "auto_dev", "effort": "low"}))
+            .expect("set_model dev");
+        let source_report = worker.handle("model", &json!({})).expect("model");
+        let source_agents = source_report["agents"].clone();
+        assert_eq!(source_agents[0]["model"], json!("auto-model"));
+        assert_eq!(source_agents[0]["effort"], json!("high"));
+        assert_eq!(source_agents[1]["model"], json!("auto-dev-model"));
+        assert_eq!(source_agents[1]["effort"], json!("low"));
+
+        // the Leader reset its context: the current thread is not epoch 1
+        let db = sessions.join(source).join("team.db");
+        let conn = rusqlite::Connection::open(&db).unwrap();
+        conn.busy_timeout(std::time::Duration::from_secs(5)).unwrap();
+        conn.execute(
+            "UPDATE agent_runtime SET context_epoch=3 WHERE session_id=?1 AND agent_id='leader'",
+            [source],
+        )
+        .unwrap();
+        drop(conn);
+
+        // a leader tree with two branches plus the legacy linear file
+        let src_member = sessions.join(source).join("members/leader");
+        std::fs::create_dir_all(&src_member).unwrap();
+        let tree = json!({
+            "ctx:leader:3": {"nodes": [
+                {"id": "n1", "parent": null, "message": {"role": "user", "content": "u1"}},
+                {"id": "n2", "parent": "n1", "message": {"role": "assistant", "content": "a1"}},
+                {"id": "n3", "parent": "n2", "message": {"role": "user", "content": "u2"}},
+                {"id": "n4", "parent": "n2", "message": {"role": "user", "content": "u2-bis"}}
+            ], "leaf": "n4", "rewind_epoch": 0},
+            "ctx:leader:2": {"nodes": [{"id": "n1", "parent": null, "message": {"role": "user", "content": "old"}}],
+                             "leaf": "n1", "rewind_epoch": 0}
+        });
+        std::fs::write(src_member.join("chat_tree.json"), tree.to_string()).unwrap();
+        std::fs::write(
+            src_member.join("chat_history.json"),
+            json!({"ctx:leader:3": [{"role": "user", "content": "u1"}],
+                   "ctx:leader:2": [{"role": "user", "content": "old"}]})
+            .to_string(),
+        )
+        .unwrap();
+        let tree_before = std::fs::read_to_string(src_member.join("chat_tree.json")).unwrap();
+        let history_before = std::fs::read_to_string(src_member.join("chat_history.json")).unwrap();
+
+        let forked = worker.handle("fork_session", &json!({})).expect("fork");
+        let new_id = forked["session_id"].as_str().unwrap().to_string();
+        assert_eq!(forked["forked_from"], json!(source));
+        assert_ne!(new_id, source);
+
+        // the same effective model config, profiles.json included
+        let forked_report = worker.handle("model", &json!({})).expect("model");
+        assert_eq!(forked_report["agents"], source_agents, "fork reports the source's /model");
+        let copied_profiles = std::fs::read_to_string(sessions.join(&new_id).join("profiles.json")).expect("profiles");
+        assert!(copied_profiles.contains("auto_leader") && copied_profiles.contains("auto_dev"), "{copied_profiles}");
+        assert!(sessions.join(&new_id).join("model_overrides.json").is_file(), "overrides copied");
+
+        // current history is mapped onto the new session's own thread; branches,
+        // nodes and the leaf survive; earlier threads are kept
+        let dst_tree: Json =
+            serde_json::from_str(&std::fs::read_to_string(sessions.join(&new_id).join("members/leader/chat_tree.json")).unwrap()).unwrap();
+        let keys: Vec<&String> = dst_tree.as_object().unwrap().keys().collect();
+        assert!(keys.contains(&&"ctx:leader:1".to_string()) && keys.contains(&&"ctx:leader:2".to_string()), "{keys:?}");
+        assert!(!keys.contains(&&"ctx:leader:3".to_string()), "source thread key must be remapped: {keys:?}");
+        assert_eq!(dst_tree["ctx:leader:1"]["leaf"], json!("n4"));
+        assert_eq!(dst_tree["ctx:leader:1"]["nodes"].as_array().unwrap().len(), 4);
+        let dst_history: Json =
+            serde_json::from_str(&std::fs::read_to_string(sessions.join(&new_id).join("members/leader/chat_history.json")).unwrap()).unwrap();
+        assert_eq!(dst_history["ctx:leader:1"][0]["content"], json!("u1"));
+        assert_eq!(dst_history["ctx:leader:2"][0]["content"], json!("old"));
+
+        // the source files were only read
+        assert_eq!(std::fs::read_to_string(src_member.join("chat_tree.json")).unwrap(), tree_before);
+        assert_eq!(std::fs::read_to_string(src_member.join("chat_history.json")).unwrap(), history_before);
+        assert!(sessions.join(source).is_dir(), "the source session survives the fork");
+
+        // the live fork resolves the Leader's history from its own thread
+        let points = worker.handle("rewind_points", &json!({})).expect("rewind_points");
+        assert_eq!(points["thread"], json!("ctx:leader:1"), "{points}");
+        assert_eq!(points["points"][0]["id"], json!("n4"), "the leaf's branch is live: {points}");
+        assert!(points["points"].as_array().unwrap().iter().any(|p| p["id"] == json!("n1")), "nodes kept: {points}");
+
+        // fresh team facts: no tasks, runs or shared entries came along
+        let state = state_of(&worker);
+        assert_eq!(state["session"]["session_id"], json!(new_id));
+        assert!(state["tasks"].as_array().unwrap().is_empty(), "{state}");
+        assert!(state["pending_approvals"].as_array().unwrap().is_empty());
+
+        // reopening the fork (a fresh open from disk) still reports the same model
+        worker
+            .handle("open", &json!({"cwd": cwd.to_string_lossy(), "scripts": {"leader": [["end"]]}}))
+            .expect("switch away");
+        let reopened = worker
+            .handle("open", &json!({"cwd": cwd.to_string_lossy(), "resume": new_id}))
+            .expect("reopen the fork");
+        assert_eq!(reopened["session_id"], json!(new_id));
+        let reopened_report = worker.handle("model", &json!({})).expect("model");
+        assert_eq!(reopened_report["agents"], source_agents, "the reopened fork keeps the source's /model");
+        worker.close_current();
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    /// Requirement 4: a fork that cannot finish removes only its own target
+    /// directory and leaves the source session open and untouched.
+    #[test]
+    fn a_failed_fork_cleans_up_and_keeps_the_source_session() {
+        let (_env, root, state_dir) = isolate("fork-fail");
+        let cwd = root.join("project");
+        std::fs::create_dir_all(&cwd).unwrap();
+        let worker = Worker::new();
+        let opened = worker
+            .handle("open", &json!({"cwd": cwd.to_string_lossy(), "resume": "proj_src_fail", "scripts": {"leader": [["end"]]}}))
+            .expect("open");
+        let source = opened["session_id"].as_str().unwrap().to_string();
+        // unreadable history: the fork fails after the target was created
+        let member = session_paths(&source).base.join("members/leader");
+        std::fs::create_dir_all(&member).unwrap();
+        std::fs::write(member.join("chat_tree.json"), "{not json").unwrap();
+        let before: Vec<String> = std::fs::read_dir(state_dir.join("teamagents/sessions")).unwrap().flatten()
+            .map(|e| e.file_name().to_string_lossy().into_owned()).collect();
+
+        let error = worker.handle("fork_session", &json!({})).expect_err("fork cannot copy the history");
+        assert!(error.contains("chat_tree.json"), "{error}");
+        let after: Vec<String> = std::fs::read_dir(state_dir.join("teamagents/sessions")).unwrap().flatten()
+            .map(|e| e.file_name().to_string_lossy().into_owned()).collect();
+        assert_eq!(before, after, "the unfinished target directory must be removed");
+        let current = worker.current().expect("the source session is still open");
+        assert_eq!(current.session_id, source);
+        assert_eq!(state_of(&worker)["session"]["session_id"], json!(source));
+        assert_eq!(
+            std::fs::read_to_string(session_paths(&source).base.join("members/leader/chat_tree.json")).unwrap(),
+            "{not json",
+            "source untouched"
+        );
+        worker.close_current();
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    /// Requirement 5: a member turn in flight refuses the fork and is left
+    /// running (never cancelled to force a fork).
+    #[test]
+    fn fork_is_refused_while_a_member_turn_is_running() {
+        let (_env, root, _state_dir) = isolate("busy");
+        let cwd = root.join("project");
+        std::fs::create_dir_all(&cwd).unwrap();
+        let worker = Worker::new();
+        let opened = worker
+            .handle("open", &json!({"cwd": cwd.to_string_lossy(), "scripts": {"leader": [["sleep", 3.0], ["end"]]}}))
+            .expect("open");
+        let session = opened["session_id"].as_str().unwrap().to_string();
+        worker.handle("user_message", &json!({"text": "go"})).expect("user_message");
+        let run_is = |worker: &Worker, status: &str| {
+            state_of(worker)["runs"]
+                .as_array()
+                .cloned()
+                .unwrap_or_default()
+                .iter()
+                .any(|r| r["status"] == json!(status))
+        };
+        assert!(wait_until(5000, || run_is(&worker, "RUNNING")), "the leader turn should be running");
+
+        let error = worker.handle("fork_session", &json!({})).expect_err("fork while busy");
+        assert!(error.contains("进行中"), "{error}");
+        assert_eq!(worker.current().expect("still open").session_id, session);
+        assert!(run_is(&worker, "RUNNING"), "the fork must not cancel the running turn");
+        worker.close_current();
+        let _ = std::fs::remove_dir_all(&root);
+    }
+}
