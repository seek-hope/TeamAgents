+/// D-26 fork, session-level model config: the source's `profiles.json`
+/// (auto-created member profiles, D-30) and `model_overrides.json` (/model
+/// choices, D-29) are copied verbatim, so the new session resolves the same
+/// profiles and reports the same effective models as its source. Auto-created
+/// profiles exist only in the source session, so this must run before the new
+/// session is opened or its spec cannot resolve them. Files are only read.
+pub fn copy_session_model_config(from_session: &str, to_session: &str) -> Result<(), String> {
+    let from = session_paths(from_session).base;
+    let to = session_paths(to_session).base;
+    std::fs::create_dir_all(&to).map_err(|e| e.to_string())?;
+    for name in ["profiles.json", "model_overrides.json"] {
+        let source = from.join(name);
+        if !source.is_file() {
+            continue;
+        }
+        std::fs::copy(&source, to.join(name)).map_err(|e| format!("fork {name}: {e}"))?;
+    }
+    Ok(())
+}
+
+/// D-26 fork, Leader history: the conversation tree and the legacy linear
+/// history follow the fork, keyed by the destination session's own thread. The
+/// source's current thread (`ctx:<leader>:<context_epoch>`) is remapped onto
+/// `dst_thread`; every branch, node and leaf inside it, and the threads of
+/// earlier epochs, are copied verbatim. The source files are only read.
+pub fn copy_leader_history(
+    from_session: &str,
+    to_session: &str,
+    leader: &str,
+    src_thread: &str,
+    dst_thread: &str,
+) -> Result<(), String> {
+    let from = session_paths(from_session).base.join("members").join(leader);
+    let to = session_paths(to_session).base.join("members").join(leader);
+    std::fs::create_dir_all(&to).map_err(|e| e.to_string())?;
+    for name in ["chat_tree.json", "chat_history.json"] {
+        let source = from.join(name);
+        if !source.is_file() {
+            continue;
+        }
+        let text = std::fs::read_to_string(&source).map_err(|e| format!("fork {name}: {e}"))?;
+        let mapped = remap_thread_key(&text, src_thread, dst_thread).map_err(|e| format!("fork {name}: {e}"))?;
+        write_json_atomic(&to.join(name), &mapped).map_err(|e| format!("fork {name}: {e}"))?;
+    }
+    Ok(())
+}
+
+/// `{thread: value}` with the source thread renamed; other threads stay put.
+fn remap_thread_key(text: &str, src_thread: &str, dst_thread: &str) -> Result<Json, String> {
+    let mut data: Json = serde_json::from_str(text).map_err(|e| e.to_string())?;
+    let Some(map) = data.as_object_mut() else {
+        return Err("history file is not a JSON object".into());
+    };
+    if src_thread != dst_thread {
+        if let Some(value) = map.remove(src_thread) {
+            map.insert(dst_thread.to_string(), value);
+        }
+    }
+    Ok(data)
+}
