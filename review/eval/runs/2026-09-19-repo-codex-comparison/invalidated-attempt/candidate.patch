+/// D-26 fork: the session-scoped model configuration the new session inherits —
+/// `profiles.json` (profiles auto-created for members by D-30) and
+/// `model_overrides.json` (/model choices, D-29). They are session config, not
+/// team facts, so they follow the conversation. Source files are only read.
+pub fn fork_model_config(src_session: &str, dest_session: &str) -> Result<(), String> {
+    for (src, name) in [
+        (profiles_path(src_session), "profiles.json"),
+        (overrides_path(src_session), "model_overrides.json"),
+    ] {
+        let Ok(text) = std::fs::read_to_string(&src) else { continue };
+        let dir = session_paths(dest_session).base;
+        std::fs::create_dir_all(&dir).map_err(|e| e.to_string())?;
+        write_text_atomic(&dir.join(name), &text)?;
+    }
+    Ok(())
+}
