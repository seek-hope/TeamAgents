+/// D-26 fork: copy the leader's conversation into the fresh session. Both the
+/// pi-style tree and the legacy linear history are carried over, with the
+/// source's live thread (`ctx:<leader>:<source_epoch>`) re-keyed to the
+/// destination's own thread id — otherwise the fork would continue on an empty
+/// thread. Abandoned branches, node ids and the leaf are preserved verbatim,
+/// and the source files are only read.
+pub fn fork_leader_conversation(
+    src_session: &str,
+    dest_session: &str,
+    leader: &str,
+    src_thread: &str,
+    dst_thread: &str,
+) -> Result<(), String> {
+    let src_dir = session_paths(src_session).base.join("members").join(leader);
+    let dest_dir = session_paths(dest_session).base.join("members").join(leader);
+    for name in ["chat_tree.json", "chat_history.json"] {
+        let Ok(text) = std::fs::read_to_string(src_dir.join(name)) else { continue };
+        let value: Json = serde_json::from_str(&text)
+            .map_err(|e| format!("session {src_session}: invalid {name}: {e}"))?;
+        let mut carried = value
+            .as_object()
+            .cloned()
+            .ok_or_else(|| format!("session {src_session}: invalid {name}: not an object"))?;
+        if src_thread != dst_thread {
+            if let Some(current) = carried.remove(src_thread) {
+                // the destination already uses its own epoch for this thread
+                carried.insert(dst_thread.to_string(), current);
+            }
+        }
+        std::fs::create_dir_all(&dest_dir).map_err(|e| e.to_string())?;
+        let text = serde_json::to_string(&Json::Object(carried)).map_err(|e| e.to_string())?;
+        write_text_atomic(&dest_dir.join(name), &text)?;
+    }
+    Ok(())
 }
 
