+//! Exact conversion between textual decimal amounts and `i64` cents.
+//!
+//! The whole module is integer based: no `f64` is ever involved, so no value is
+//! truncated, rounded or saturated. Out-of-range inputs return an error instead
+//! of panicking, and the full `i64` cent range round-trips exactly.
+
+/// Longest magnitude a legal (possibly negative) cent value can have.
+const MAX_MAGNITUDE: i128 = i64::MAX as i128 + 1;
+
+fn invalid() -> String {
+    "金额无效".to_owned()
+}
+
+/// Parse a textual amount into cents.
+///
+/// Accepted grammar (after trimming surrounding whitespace):
+///
+/// ```text
+/// ["-"] digits [ "." 1*2 digits ]
+/// ```
+///
+/// * leading/trailing whitespace is ignored;
+/// * an optional `-` sign is allowed; `+` is not;
+/// * at least one integer digit is required, so `.5`, `-`, and `""` are invalid;
+/// * the fractional part, when present, must have exactly one or two digits,
+///   so `12.` and `1.234` are invalid;
+/// * exponents, non-ASCII/non-digit characters and separators are invalid.
+///
+/// The conversion is exact and supports the complete `i64` range; any overflow
+/// yields `Err`.
 pub fn parse_cents(input: &str) -> Result<i64, String> {
-    let amount: f64 = input.trim().parse().map_err(|_| "金额无效".to_owned())?;
-    Ok((amount * 100.0) as i64)
-}
-
+    let trimmed = input.trim();
+    let (negative, unsigned) = match trimmed.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, trimmed),
+    };
+
+    let mut parts = unsigned.split('.');
+    let integer = parts.next().unwrap_or("");
+    let fraction = parts.next();
+    // A second '.' (e.g. `1.2.3`) means more than one separator.
+    if parts.next().is_some() {
+        return Err(invalid());
+    }
+
+    if integer.is_empty() || !integer.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err(invalid());
+    }
+
+    let fraction_value: i128 = match fraction {
+        None => 0,
+        Some(digits) => {
+            if digits.is_empty()
+                || digits.len() > 2
+                || !digits.bytes().all(|byte| byte.is_ascii_digit())
+            {
+                return Err(invalid());
+            }
+            let mut value = 0i128;
+            for byte in digits.bytes() {
+                value = value * 10 + i128::from(byte - b'0');
+            }
+            if digits.len() == 1 {
+                value *= 10;
+            }
+            value
+        }
+    };
+
+    // Accumulate the integer part with checked arithmetic so arbitrarily long
+    // inputs cannot overflow the intermediate type or panic.
+    let mut magnitude = 0i128;
+    for byte in integer.bytes() {
+        let digit = i128::from(byte - b'0');
+        magnitude = magnitude
+            .checked_mul(10)
+            .and_then(|value| value.checked_add(digit))
+            .ok_or_else(invalid)?;
+    }
+    let magnitude = magnitude
+        .checked_mul(100)
+        .and_then(|value| value.checked_add(fraction_value))
+        .ok_or_else(invalid)?;
+
+    if negative {
+        if magnitude > MAX_MAGNITUDE {
+            return Err(invalid());
+        }
+        // `magnitude == MAX_MAGNITUDE` is exactly `i64::MIN`.
+        Ok((-magnitude) as i64)
+    } else {
+        if magnitude > i64::MAX as i128 {
+            return Err(invalid());
+        }
+        Ok(magnitude as i64)
+    }
+}
+
+/// Format cents as a fixed two-decimal amount, keeping the sign of negative
+/// values and covering the complete `i64` range.
 pub fn format_cents(cents: i64) -> String {
-    format!("{}.{:02}", cents / 100, (cents % 100).abs())
-}
+    // Use i128 so that `i64::MIN` can be negated without overflowing.
+    let magnitude = (cents as i128).abs();
+    let integer = magnitude / 100;
+    let fraction = magnitude % 100;
+    if cents < 0 {
+        format!("-{}.{:02}", integer, fraction)
+    } else {
+        format!("{}.{:02}", integer, fraction)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn accepts_documented_examples() {
+        assert_eq!(parse_cents("-0.01").unwrap(), -1);
+        assert_eq!(parse_cents("12").unwrap(), 1200);
+        assert_eq!(parse_cents("12.3").unwrap(), 1230);
+        assert_eq!(parse_cents("12.30").unwrap(), 1230);
+        assert_eq!(parse_cents("  7.5  ").unwrap(), 750);
+        assert_eq!(parse_cents("0.01").unwrap(), 1);
+        assert_eq!(parse_cents("-12.34").unwrap(), -1234);
