+    }
+
+    #[test]
+    fn exactness_that_f64_would_break() {
+        // 0.29 * 100 == 28.999... in binary floating point.
+        assert_eq!(parse_cents("0.29").unwrap(), 29);
+        assert_eq!(parse_cents("8.29").unwrap(), 829);
+        assert_eq!(parse_cents("1.15").unwrap(), 115);
+        assert_eq!(parse_cents("-8.29").unwrap(), -829);
+        assert_eq!(
+            parse_cents("92233720368547758.07").unwrap(),
+            i64::MAX
+        );
+        assert_eq!(
+            parse_cents("-92233720368547758.08").unwrap(),
+            i64::MIN
+        );
+    }
+
+    #[test]
+    fn rejects_invalid_forms() {
+        for bad in [
+            "", "   ", "+5", "+5.0", "abc", "1e3", "1E3", "1.2.3", ".5", "-.5", "-", ".",
+            "12.", "1.234", "-1.234", "1,5", "1 5", "--1", "-+1", "0x10", "NaN", "inf",
+            "- 1", "+.5", "1_000",
+        ] {
+            assert!(parse_cents(bad).is_err(), "expected error for {:?}", bad);
+        }
+    }
+
+    #[test]
+    fn rejects_overflow_without_panicking() {
+        assert!(parse_cents("92233720368547758.08").is_err());
+        assert!(parse_cents("-92233720368547758.09").is_err());
+        assert!(parse_cents("999999999999999999999999999999999999999999").is_err());
+        assert!(parse_cents("-999999999999999999999999999999999999999999").is_err());
+    }
+
+    #[test]
+    fn format_keeps_sign_and_pads() {
+        assert_eq!(format_cents(0), "0.00");
+        assert_eq!(format_cents(1), "0.01");
+        assert_eq!(format_cents(-1), "-0.01");
+        assert_eq!(format_cents(-100), "-1.00");
+        assert_eq!(format_cents(1230), "12.30");
+        assert_eq!(format_cents(i64::MAX), "92233720368547758.07");
+        assert_eq!(format_cents(i64::MIN), "-92233720368547758.08");
+    }
+
+    #[test]
+    fn round_trips_over_full_range() {
+        let samples = [
+            i64::MIN,
+            i64::MIN + 1,
+            -123456,
+            -829,
+            -100,
+            -99,
+            -1,
+            0,
+            1,
+            99,
+            100,
+            829,
+            123456,
+            i64::MAX - 1,
+            i64::MAX,
+        ];
+        for cents in samples {
+            let text = format_cents(cents);
+            assert_eq!(parse_cents(&text).unwrap(), cents, "text = {:?}", text);
+        }
+    }
