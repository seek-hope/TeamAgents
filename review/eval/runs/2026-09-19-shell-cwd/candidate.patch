+/// Request IDs and account names are limited to ASCII letters, digits,
+/// underscore and hyphen, and must be non-empty.
+pub(crate) fn is_valid_name(name: &str) -> bool {
+    !name.is_empty()
+        && name
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+}
+
+fn require_name(value: &str) -> Result<&str, String> {
+    if is_valid_name(value) {
+        Ok(value)
+    } else {
+        Err("请求ID或账户只能包含 ASCII 字母、数字、下划线和连字符".to_owned())
+    }
+}
+
+fn require_positive_amount(value: &str) -> Result<i64, String> {
+    let cents = parse_cents(value)?;
+    if cents <= 0 {
+        return Err("金额必须大于零".to_owned());
+    }
+    Ok(cents)
+}
+
+fn parse_line(fields: &[&str]) -> Result<Event, String> {
+    match fields {
+        ["deposit", id, account, amount] => Ok(Event::Deposit {
+            id: require_name(id)?.to_owned(),
+            account: require_name(account)?.to_owned(),
+            cents: require_positive_amount(amount)?,
+        }),
+        ["transfer", id, from, to, amount] => Ok(Event::Transfer {
+            id: require_name(id)?.to_owned(),
+            from: require_name(from)?.to_owned(),
+            to: require_name(to)?.to_owned(),
+            cents: require_positive_amount(amount)?,
+        }),
+        _ => Err("流水格式无效".to_owned()),
+    }
+}
