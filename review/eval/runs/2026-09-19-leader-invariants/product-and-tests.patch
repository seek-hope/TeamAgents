+                assert!(message.contains("invalid:") && message.contains(expected), "{message}");
+            } else {
+                assert!(message.contains("ok:"), "{message}");
+            }
+            assert_eq!(std::fs::read_to_string(path).unwrap(), text);
+        }
+    }
+    std::fs::remove_dir_all(root).unwrap();
