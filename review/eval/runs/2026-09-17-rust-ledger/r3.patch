+//! Exact integer amount parsing and formatting.
+//!
+//! Amounts are represented as `i64` cents. Parsing never goes through
+//! floating point, so values like `0.29` and `1.15` are exact and the whole
+//! `i64` range round-trips without rounding, truncation or saturation.
+
+const INVALID_AMOUNT: &str = "金额无效";
+
+/// Parse a decimal amount such as `12`, `12.3` or `-0.01` into cents.
+///
+/// Grammar (after trimming surrounding whitespace):
+///   `-`? ascii-digit+ (`.` ascii-digit{1,2})?
+///
+/// The full `i64` cents range is supported exactly. Values outside the range
+/// (for example `92233720368547758.08`) are rejected with `Err`.
 pub fn parse_cents(input: &str) -> Result<i64, String> {
-    let amount: f64 = input.trim().parse().map_err(|_| "金额无效".to_owned())?;
-    Ok((amount * 100.0) as i64)
+    let text = input.trim();
+    let (negative, unsigned) = match text.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, text),
+    };
+
+    let (int_part, frac_part) = match unsigned.split_once('.') {
+        Some((int_part, frac_part)) => (int_part, Some(frac_part)),
+        None => (unsigned, None),
+    };
+
+    if int_part.is_empty() || !int_part.bytes().all(|b| b.is_ascii_digit()) {
+        return Err(INVALID_AMOUNT.to_owned());
+    }
+
+    let fraction: i128 = match frac_part {
+        None => 0,
+        Some(frac) => {
+            if frac.is_empty() || frac.len() > 2 || !frac.bytes().all(|b| b.is_ascii_digit()) {
+                return Err(INVALID_AMOUNT.to_owned());
+            }
+            let mut value: i128 = 0;
+            for b in frac.bytes() {
+                value = value * 10 + i128::from(b - b'0');
+            }
+            if frac.len() == 1 {
+                value * 10
+            } else {
+                value
+            }
+        }
+    };
+
+    // Bound on the absolute magnitude in cents: i64::MAX for positive values,
+    // 2^63 for negative values (i64::MIN has one more unit of magnitude).
+    let limit: i128 = if negative {
+        -(i64::MIN as i128)
+    } else {
+        i64::MAX as i128
+    };
+
+    let mut magnitude: i128 = 0;
+    for b in int_part.bytes() {
+        magnitude = magnitude * 10 + i128::from(b - b'0');
+        if magnitude > limit {
+            return Err(INVALID_AMOUNT.to_owned());
+        }
+    }
+    magnitude = magnitude * 100 + fraction;
+    if magnitude > limit {
+        return Err(INVALID_AMOUNT.to_owned());
+    }
+
+    let signed = if negative { -magnitude } else { magnitude };
+    Ok(signed as i64)
 }
 
+/// Format cents as a decimal string with exactly two fraction digits.
+///
+/// A sign is emitted for every negative value (`-1` -> `"-0.01"`), including
+/// `i64::MIN`. The result round-trips through [`parse_cents`].
 pub fn format_cents(cents: i64) -> String {
-    format!("{}.{:02}", cents / 100, (cents % 100).abs())
+    let negative = cents < 0;
+    let magnitude = cents.unsigned_abs();
+    let whole = magnitude / 100;
+    let fraction = magnitude % 100;
+    if negative {
+        format!("-{whole}.{fraction:02}")
+    } else {
+        format!("{whole}.{fraction:02}")
+    }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_exact_decimals() {
+        assert_eq!(parse_cents("0.29"), Ok(29));
+        assert_eq!(parse_cents("1.15"), Ok(115));
+        assert_eq!(parse_cents("12"), Ok(1200));
+        assert_eq!(parse_cents("12.3"), Ok(1230));
+        assert_eq!(parse_cents("-0.01"), Ok(-1));
+        assert_eq!(parse_cents("  42.42  "), Ok(4242));
+        assert_eq!(parse_cents("-7"), Ok(-700));
+        assert_eq!(parse_cents("0"), Ok(0));
+        assert_eq!(parse_cents("-0.00"), Ok(0));
+    }
+
+    #[test]
+    fn rejects_invalid_grammar() {
+        for bad in [
+            "",
+            " ",
+            ".",
+            ".5",
+            "-.",
+            "12.",
+            "+12",
+            "1e2",
+            "1E2",
+            "abc",
+            "--1",
+            "1.234",
+            "12 . 3",
+            "1.2.3",
+            "12,3",
+            "1-",
+            "１２", // fullwidth digits are not ASCII digits
+            "1.2 3",
+            "1 2",
+            "  ",
+        ] {
+            assert!(parse_cents(bad).is_err(), "should reject {bad:?}");
+        }
+    }
+
+    #[test]
+    fn supports_full_i64_range() {
+        assert_eq!(parse_cents("92233720368547758.07").unwrap(), i64::MAX);
+        assert_eq!(parse_cents("-92233720368547758.08").unwrap(), i64::MIN);
+        assert!(parse_cents("92233720368547758.08").is_err());
+        assert!(parse_cents("-92233720368547758.09").is_err());
+        assert!(parse_cents("92233720368547759").is_err());
+        assert!(parse_cents("99999999999999999999999999").is_err());
+        assert!(parse_cents("-99999999999999999999999999").is_err());
+    }
+
+    #[test]
+    fn formats_negatives_with_sign() {
+        assert_eq!(format_cents(-1), "-0.01");
+        assert_eq!(format_cents(-100), "-1.00");
+        assert_eq!(format_cents(-12345), "-123.45");
+        assert_eq!(format_cents(0), "0.00");
+        assert_eq!(format_cents(5), "0.05");
+        assert_eq!(format_cents(i64::MIN), "-92233720368547758.08");
+        assert_eq!(format_cents(i64::MAX), "92233720368547758.07");
+    }
+
+    #[test]
+    fn format_parse_round_trip() {
+        for cents in [
+            i64::MIN,
+            i64::MIN + 1,
+            -12345,
+            -101,
+            -1,
+            0,
+            1,
+            99,
+            100,
+            101,
+            i64::MAX - 1,
+            i64::MAX,
+        ] {
+            let text = format_cents(cents);
+            assert_eq!(parse_cents(&text), Ok(cents), "round trip failed for {text:?}");
+        }
+    }
+}
