+/// Request ids and account names may only contain ASCII letters, digits,
+/// `_` and `-`, and must not be empty.
+pub(crate) fn is_valid_token(text: &str) -> bool {
+    !text.is_empty()
+        && text
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+}
+
+fn line_error(line_no: usize, message: &str) -> String {
+    format!("第 {} 行：{}", line_no, message)
+}
+
+/// Parse the ledger input into events, in input order.
+///
+/// Lines are split on `\n` (a trailing `\r` is tolerated). The line number of
+/// each diagnostic refers to the physical line of the original input, with
+/// blank and `#` comment lines counted. Every line and every field is trimmed
+/// before matching; a non-comment line must be exactly one of
+/// `deposit,id,account,amount` or `transfer,id,from,to,amount`.
 pub fn parse_events(input: &str) -> Result<Vec<Event>, String> {
-    input.lines().filter(|line| !line.is_empty() && !line.starts_with('#'))
-        .enumerate().map(|(index, line)| {
-            let fields: Vec<_> = line.split(',').collect();
-            let result = match fields.as_slice() {
-                ["deposit", id, account, amount] => parse_cents(amount).map(|cents| Event::Deposit {
-                    id: (*id).to_owned(), account: (*account).to_owned(), cents,
-                }),
-                ["transfer", id, from, to, amount] => parse_cents(amount).map(|cents| Event::Transfer {
-                    id: (*id).to_owned(), from: (*from).to_owned(), to: (*to).to_owned(), cents,
-                }),
-                _ => Err("流水格式无效".to_owned()),
-            };
-            result.map_err(|error| format!("第 {} 行：{}", index + 1, error))
-        }).collect()
-}
+    let mut events = Vec::new();
+
+    for (index, raw_line) in input.split('\n').enumerate() {
+        let line_no = index + 1;
+        let line = raw_line.strip_suffix('\r').unwrap_or(raw_line).trim();
+
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+
+        let fields: Vec<&str> = line.split(',').map(str::trim).collect();
+        let event = match fields.as_slice() {
+            ["deposit", id, account, amount] => {
+                if !is_valid_token(id) {
+                    return Err(line_error(line_no, "请求编号无效"));
+                }
+                if !is_valid_token(account) {
+                    return Err(line_error(line_no, "账户名无效"));
+                }
+                let cents = parse_cents(amount).map_err(|e| line_error(line_no, &e))?;
+                if cents <= 0 {
+                    return Err(line_error(line_no, "金额必须大于零"));
+                }
+                Event::Deposit {
+                    id: (*id).to_owned(),
+                    account: (*account).to_owned(),
+                    cents,
+                }
+            }
+            ["transfer", id, from, to, amount] => {
+                if !is_valid_token(id) {
+                    return Err(line_error(line_no, "请求编号无效"));
+                }
+                if !is_valid_token(from) || !is_valid_token(to) {
+                    return Err(line_error(line_no, "账户名无效"));
+                }
+                let cents = parse_cents(amount).map_err(|e| line_error(line_no, &e))?;
+                if cents <= 0 {
+                    return Err(line_error(line_no, "金额必须大于零"));
+                }
+                Event::Transfer {
+                    id: (*id).to_owned(),
+                    from: (*from).to_owned(),
+                    to: (*to).to_owned(),
+                    cents,
+                }
+            }
+            _ => return Err(line_error(line_no, "流水格式无效")),
+        };
+
+        events.push(event);
+    }
+
+    Ok(events)
+}
