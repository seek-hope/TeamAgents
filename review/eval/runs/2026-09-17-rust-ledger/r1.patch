+        assert!(ledger.apply(&deposit("d2", "alice", 1)).is_err());
+        assert_eq!(ledger.balance("alice"), Some(i64::MAX));
+
+        ledger.apply(&deposit("d3", "bob", i64::MAX)).unwrap();
+        assert!(ledger.apply(&transfer("t1", "alice", "bob", 1)).is_err());
+        assert_eq!(ledger.balance("alice"), Some(i64::MAX));
+        assert_eq!(ledger.balance("bob"), Some(i64::MAX));
