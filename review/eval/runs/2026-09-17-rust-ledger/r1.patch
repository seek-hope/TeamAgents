+fn parse_positive_amount(amount: &str) -> Result<i64, String> {
+    let cents = parse_cents(amount)?;
+    if cents <= 0 {
+        Err("金额必须大于 0".to_owned())
+    } else {
+        Ok(cents)
+    }
+}
