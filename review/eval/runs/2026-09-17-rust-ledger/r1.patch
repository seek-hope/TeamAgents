+/// 按字符串逐位精确解析金额（元）为分，禁止使用浮点数。
+///
+/// 语法：先 trim 首尾空白；可选一个 `-`；至少 1 位 ASCII 数字整数部分；
+/// 可选 `.` 加 1 或 2 位小数。其余字符（`+`、指数、全角数字、内部空白等）均拒绝。
 pub fn parse_cents(input: &str) -> Result<i64, String> {
-    let amount: f64 = input.trim().parse().map_err(|_| "金额无效".to_owned())?;
-    Ok((amount * 100.0) as i64)
+    let trimmed = input.trim();
+    let (negative, body) = match trimmed.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, trimmed),
+    };
+
+    let (integer_part, fraction_part) = match body.split_once('.') {
+        Some((integer_part, fraction_part)) => {
+            // `1.2.3` 之类的多余小数点在此拒绝。
+            if fraction_part.contains('.') {
+                return Err(INVALID_AMOUNT.to_owned());
+            }
+            (integer_part, Some(fraction_part))
+        }
+        None => (body, None),
+    };
+
+    if integer_part.is_empty() || !integer_part.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err(INVALID_AMOUNT.to_owned());
+    }
+
+    let fraction_cents: i128 = match fraction_part {
+        None => 0,
+        Some(fraction) => {
+            if fraction.is_empty()
+                || fraction.len() > 2
+                || !fraction.bytes().all(|byte| byte.is_ascii_digit())
+            {
+                return Err(INVALID_AMOUNT.to_owned());
+            }
+            let mut value: i128 = 0;
+            for byte in fraction.bytes() {
+                value = value * 10 + i128::from(byte - b'0');
+            }
+            if fraction.len() == 1 {
+                value * 10
+            } else {
+                value
+            }
+        }
+    };
+
+    // 先在 i128 内逐位累加并检测溢出，最后再用 i64::try_from 检查范围；
+    // 这样 `-92233720368547758.08`（i64::MIN）不会被正向中间值溢出误伤。
+    let mut magnitude: i128 = 0;
+    for byte in integer_part.bytes() {
+        magnitude = magnitude
+            .checked_mul(10)
+            .and_then(|value| value.checked_add(i128::from(byte - b'0')))
+            .ok_or_else(|| INVALID_AMOUNT.to_owned())?;
+    }
+    magnitude = magnitude
+        .checked_mul(100)
+        .and_then(|value| value.checked_add(fraction_cents))
+        .ok_or_else(|| INVALID_AMOUNT.to_owned())?;
+
+    let signed = if negative { -magnitude } else { magnitude };
+    i64::try_from(signed).map_err(|_| INVALID_AMOUNT.to_owned())
 }
 
