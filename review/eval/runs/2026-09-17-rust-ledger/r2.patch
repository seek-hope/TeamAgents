+//! 金额解析与格式化：内部统一使用 i64 分（cent）作为最小单位。
+//!
+//! 全部转换均使用整数运算，不依赖任何浮点类型，保证结果精确，并覆盖
+//! i64 分的完整取值范围。
+
+/// 将金额字符串解析为“分”。
+///
+/// 接受的格式：
+/// - 可选的首尾空白；
+/// - 可选的前导 `-`（不支持 `+`）；
+/// - 至少一位十进制数字的整数部分；
+/// - 可选的 `.`，其后必须恰好是 1 或 2 位十进制数字。
+///
+/// 例如 `-0.01`、`12`、`12.3`、`12.30` 均有效；`+12`、`1e5`、`.5`、
+/// `12.`、`12.345`、`--1`、`-`、空串、非 ASCII 数字等一律返回 `Err`。
+///
+/// 支持 i64 分的完整范围：正数最大为 `92233720368547758.07`
+/// （`i64::MAX`），负数最小为 `-92233720368547758.08`（`i64::MIN`）。
+/// 任何溢出（包括具有数千位数字的输入）都会返回 `Err`，绝不截断、
+/// 舍入、饱和或 panic。
 pub fn parse_cents(input: &str) -> Result<i64, String> {
-    let amount: f64 = input.trim().parse().map_err(|_| "金额无效".to_owned())?;
-    Ok((amount * 100.0) as i64)
+    fn invalid() -> String {
+        "金额无效".to_owned()
+    }
+
+    let trimmed = input.trim();
+    if trimmed.is_empty() {
+        return Err(invalid());
+    }
+
+    let (negative, rest) = match trimmed.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, trimmed),
+    };
+    if rest.is_empty() {
+        return Err(invalid());
+    }
+
+    let (integer_part, fraction_part) = match rest.split_once('.') {
+        Some((integer_part, fraction_part)) => {
+            if fraction_part.contains('.') {
+                return Err(invalid());
+            }
+            (integer_part, Some(fraction_part))
+        }
+        None => (rest, None),
+    };
+
+    if integer_part.is_empty() {
+        return Err(invalid());
+    }
+
+    match fraction_part {
+        Some(fraction) if fraction.len() == 1 || fraction.len() == 2 => {}
+        Some(_) => return Err(invalid()),
+        None => {}
+    }
+
+    // 负数允许的绝对值上限为 |i64::MIN| = 2^63，正数上限为 i64::MAX = 2^63 - 1。
+    let max_magnitude: u64 = if negative { 1u64 << 63 } else { (1u64 << 63) - 1 };
+
+    // 依次累积整数部分（单位为“元”）。一旦超过上限立即失败，因此
+    // 数千位的输入也会在十几个数字之内快速返回，不会长时间累积。
+    let mut magnitude: u64 = 0;
+    for byte in integer_part.bytes() {
+        if !byte.is_ascii_digit() {
+            return Err(invalid());
+        }
+        let digit = u64::from(byte - b'0');
+        magnitude = magnitude
+            .checked_mul(10)
+            .and_then(|value| value.checked_add(digit))
+            .ok_or_else(invalid)?;
+        if magnitude > max_magnitude {
+            return Err(invalid());
+        }
+    }
+
+    // 元转分。
+    magnitude = magnitude.checked_mul(100).ok_or_else(invalid)?;
+
+    if let Some(fraction) = fraction_part {
+        let mut fraction_cents: u64 = 0;
+        for byte in fraction.bytes() {
+            if !byte.is_ascii_digit() {
+                return Err(invalid());
+            }
+            fraction_cents = fraction_cents * 10 + u64::from(byte - b'0');
+        }
+        if fraction.len() == 1 {
+            fraction_cents *= 10;
+        }
+        magnitude = magnitude.checked_add(fraction_cents).ok_or_else(invalid)?;
+    }
+
+    if magnitude > max_magnitude {
+        return Err(invalid());
+    }
+
+    if negative {
+        // magnitude == 2^63 时 `as i64` 得到 i64::MIN，取负仍为其自身。
+        Ok((magnitude as i64).wrapping_neg())
+    } else {
+        Ok(magnitude as i64)
+    }
 }
 
+/// 将“分”格式化为带两位小数、负数保留 `-` 的字符串。
+///
+/// 例如 `-1` -> `-0.01`、`0` -> `0.00`、`1230` -> `12.30`、
+/// `i64::MIN` -> `-92233720368547758.08`。
+/// 对任意 i64 值均有 `parse_cents(format_cents(x)) == Ok(x)`。
 pub fn format_cents(cents: i64) -> String {
-    format!("{}.{:02}", cents / 100, (cents % 100).abs())
+    let magnitude = (cents as i128).abs();
+    let sign = if cents < 0 { "-" } else { "" };
+    format!("{}{}.{:02}", sign, magnitude / 100, magnitude % 100)
 }
+
