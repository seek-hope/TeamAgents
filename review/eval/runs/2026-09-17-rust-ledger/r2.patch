+/// Reads the whole stdin, builds the report and only then writes it to stdout.
+/// Any error exits non-zero with a message on stderr and nothing on stdout.
+fn run() -> Result<(), String> {
+    let mut input = String::new();
+    io::stdin()
+        .read_to_string(&mut input)
+        .map_err(|error| format!("读取流水失败：{error}"))?;
+
+    let output = eval_ledger::run(&input)?;
+
+    let mut stdout = io::stdout().lock();
+    stdout
+        .write_all(output.as_bytes())
+        .map_err(|error| format!("写出报表失败：{error}"))
