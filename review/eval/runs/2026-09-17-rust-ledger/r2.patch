+/// 请求编号与账户名：非空，且只允许 ASCII 字母、数字、下划线和连字符。
+fn is_valid_identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+}
+
+fn line_error(line_number: usize, reason: &str) -> String {
+    format!("第 {} 行：{}", line_number, reason)
+}
+
+/// 校验金额字段：必须能精确解析为“分”，且严格大于零。
+fn positive_cents(line_number: usize, amount: &str) -> Result<i64, String> {
+    let cents = parse_cents(amount).map_err(|error| line_error(line_number, &error))?;
+    if cents <= 0 {
+        return Err(line_error(line_number, "金额必须大于零"));
+    }
+    Ok(cents)
+}
+
+/// 解析整份流水输入。遇到第一条非法行立刻返回错误（物理行号从 1 开始）。
 pub fn parse_events(input: &str) -> Result<Vec<Event>, String> {
-    input.lines().filter(|line| !line.is_empty() && !line.starts_with('#'))
-        .enumerate().map(|(index, line)| {
-            let fields: Vec<_> = line.split(',').collect();
-            let result = match fields.as_slice() {
-                ["deposit", id, account, amount] => parse_cents(amount).map(|cents| Event::Deposit {
-                    id: (*id).to_owned(), account: (*account).to_owned(), cents,
-                }),
-                ["transfer", id, from, to, amount] => parse_cents(amount).map(|cents| Event::Transfer {
-                    id: (*id).to_owned(), from: (*from).to_owned(), to: (*to).to_owned(), cents,
-                }),
-                _ => Err("流水格式无效".to_owned()),
-            };
-            result.map_err(|error| format!("第 {} 行：{}", index + 1, error))
-        }).collect()
-}
+    let mut events = Vec::new();
+
+    // 按 `\n` 切分以保证物理行号；行尾的 `\r`（CRLF）由 trim 去除。
+    for (index, raw_line) in input.split('\n').enumerate() {
+        let line_number = index + 1;
+        let line = raw_line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+
+        let fields: Vec<&str> = line.split(',').map(str::trim).collect();
+        let event = match fields.as_slice() {
+            ["deposit", id, account, amount] => {
+                if !is_valid_identifier(id) {
+                    return Err(line_error(line_number, "请求编号无效"));
+                }
+                if !is_valid_identifier(account) {
+                    return Err(line_error(line_number, "账户名无效"));
+                }
+                let cents = positive_cents(line_number, amount)?;
+                Event::Deposit {
+                    id: (*id).to_owned(),
+                    account: (*account).to_owned(),
+                    cents,
+                }
+            }
+            ["transfer", id, from, to, amount] => {
+                if !is_valid_identifier(id) {
+                    return Err(line_error(line_number, "请求编号无效"));
+                }
+                if !is_valid_identifier(from) {
+                    return Err(line_error(line_number, "源账户名无效"));
+                }
+                if !is_valid_identifier(to) {
+                    return Err(line_error(line_number, "目标账户名无效"));
+                }
+                let cents = positive_cents(line_number, amount)?;
+                Event::Transfer {
+                    id: (*id).to_owned(),
+                    from: (*from).to_owned(),
+                    to: (*to).to_owned(),
+                    cents,
+                }
+            }
+            _ => return Err(line_error(line_number, "字段数量无效或交易类型未知")),
+        };
+        events.push(event);
+    }
+
+    Ok(events)
+}
