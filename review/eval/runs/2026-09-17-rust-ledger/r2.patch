+/// Independently validates an event so `apply` never trusts the parser layer.
+fn validate_event(event: &Event) -> Result<(), String> {
+    match event {
+        Event::Deposit {
+            id,
+            account,
+            cents,
+            ..
+        } => {
+            if !valid_name(id) {
+                return Err("请求编号无效".to_owned());
+            }
+            if !valid_name(account) {
+                return Err("账户名称无效".to_owned());
+            }
+            if *cents <= 0 {
+                return Err("金额必须大于零".to_owned());
+            }
+        }
+        Event::Transfer {
+            id,
+            from,
+            to,
+            cents,
+            ..
+        } => {
+            if !valid_name(id) {
+                return Err("请求编号无效".to_owned());
+            }
+            if !valid_name(from) || !valid_name(to) {
+                return Err("账户名称无效".to_owned());
+            }
+            if *cents <= 0 {
+                return Err("金额必须大于零".to_owned());
+            }
+        }
+    }
+    Ok(())
+}
