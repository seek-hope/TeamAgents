===== csvfix/impl.py =====
def parse(line):
    """BUG: 不处理引号、不裁剪空白、不校验列数。"""
    return line.split(",")

def total(rows):
    """BUG: 空字段当作 0 但不报错，且把第三列当成金额。"""
    return sum(int(r[2]) for r in rows if len(r) > 2 and r[2])

===== csvfix/test_csvfix.py =====
import impl

def test_parse_trims_and_validates():
    assert impl.parse(' a , 2 , x ') == ["a", "2", "x"]
    assert impl.parse('a,2') is None  # 列数不是 3 时返回 None

def test_total_skips_blank_and_reports_bad():
    rows = [["a", "1", "2"], ["b", "2", ""]]
    assert impl.total(rows) == 2

