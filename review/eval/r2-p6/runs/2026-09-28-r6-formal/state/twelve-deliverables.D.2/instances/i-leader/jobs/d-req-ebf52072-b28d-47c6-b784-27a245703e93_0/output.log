def parse(line):
    """BUG: M-dM-8M-^MM-eM-$M-^DM-gM-^PM-^FM-eM-<M-^UM-eM-^OM-7M-cM-^@M-^AM-dM-8M-^MM-hM-#M-^AM-eM-^IM-*M-gM-)M-:M-gM-^YM-=M-cM-^@M-^AM-dM-8M-^MM-fM- M-!M-iM-*M-^LM-eM-^HM-^WM-fM-^UM-0M-cM-^@M-^B"""
    return line.split(",")

def total(rows):
    """BUG: M-gM-)M-:M-eM--M-^WM-fM-.M-5M-eM-=M-^SM-dM-=M-^\ 0 M-dM-=M-^FM-dM-8M-^MM-fM-^JM-%M-iM-^TM-^YM-oM-<M-^LM-dM-8M-^TM-fM-^JM-^JM-gM-,M-,M-dM-8M-^IM-eM-^HM-^WM-eM-=M-^SM-fM-^HM-^PM-iM-^GM-^QM-iM-"M-^]M-cM-^@M-^B"""
    return sum(int(r[2]) for r in rows if len(r) > 2 and r[2])

