########## units/chain/stage1.py ##########
import csv


def parse_orders(path):
    """Read a CSV file with ``id,qty,price`` columns into a list of dicts.

    Numeric fields are converted to ints. The header row is skipped.
    """
    rows = []
    with open(path, newline="") as fh:
        reader = csv.DictReader(fh)
        for row in reader:
            rows.append({
                "id": int(row["id"]),
                "qty": int(row["qty"]),
                "price": int(row["price"]),
            })
    return rows

########## units/chain/stage2.py ##########
def filter_orders(rows):
    """Keep only orders with a positive quantity, preserving order."""
    return [row for row in rows if row["qty"] > 0]

########## units/chain/stage3.py ##########
def total_by_price(rows):
    """Sum ``qty`` grouped by ``price`` and return a ``{price: total}`` dict."""
    totals = {}
    for row in rows:
        totals[row["price"]] = totals.get(row["price"], 0) + row["qty"]
    return totals

########## units/chain/stage4.py ##########
def report(totals):
    """Render ``{price: total}`` as ``"price:total\\n"`` lines sorted by price."""
    return "".join(
        "{}:{}\n".format(price, totals[price])
        for price in sorted(totals)
    )

