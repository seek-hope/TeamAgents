----- units/chain/stage1.py -----
import csv


def parse_orders(path):
    """Read the orders CSV (header: id,qty,price) into a list of dicts with int values."""
    rows = []
    with open(path, newline="") as fh:
        reader = csv.DictReader(fh)
        for row in reader:
            rows.append({key: int(value) for key, value in row.items()})
    return rows

----- units/chain/stage2.py -----
def filter_orders(rows):
    """Keep only the rows whose qty is greater than zero."""
    return [row for row in rows if row["qty"] > 0]

----- units/chain/stage3.py -----
def total_by_price(rows):
    """Sum qty per price, returning {price: total_qty}."""
    totals = {}
    for row in rows:
        totals[row["price"]] = totals.get(row["price"], 0) + row["qty"]
    return totals

----- units/chain/stage4.py -----
def report(totals):
    """Render {price: qty} as one "price:qty\\n" line per price, ascending by price."""
    return "".join(f"{price}:{totals[price]}\n" for price in sorted(totals))

