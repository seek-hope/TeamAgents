===== units/chain/tests/test_stage1.py =====
from stage1 import parse_orders
def test_parse():
    rows = parse_orders("data/orders.csv")
    assert rows == [{"id":1,"qty":2,"price":10},{"id":2,"qty":0,"price":5},{"id":3,"qty":3,"price":7},{"id":4,"qty":1,"price":7}], rows

===== units/chain/tests/test_stage2.py =====
from stage2 import filter_orders
def test_filter():
    rows = [{"id":1,"qty":2,"price":10},{"id":2,"qty":0,"price":5}]
    assert filter_orders(rows) == [{"id":1,"qty":2,"price":10}]

===== units/chain/tests/test_stage3.py =====
from stage3 import total_by_price
def test_totals():
    rows = [{"id":1,"qty":2,"price":10},{"id":3,"qty":3,"price":7},{"id":4,"qty":1,"price":7}]
    assert total_by_price(rows) == {10:2, 7:4}

