' "a,b" , 2 , x ' -> [[' "a', 'b" ', ' 2 ', ' x ']]
   skipinit -> [['a,b ', '2 ', 'x ']]
'a,2,x' -> [['a', '2', 'x']]
   skipinit -> [['a', '2', 'x']]
' a , 2 , x ' -> [[' a ', ' 2 ', ' x ']]
   skipinit -> [['a ', '2 ', 'x ']]
'"a,b",2,x' -> [['a,b', '2', 'x']]
   skipinit -> [['a,b', '2', 'x']]
'x,"y,z",w' -> [['x', 'y,z', 'w']]
   skipinit -> [['x', 'y,z', 'w']]
