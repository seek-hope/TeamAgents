     1	from flags import Impl
     2	
     3	I = Impl()
     4	
     5	def test_equals_and_space_forms_agree():
     6	    assert I.parse(["--mode=fast", "-v"]) == {"values": {"mode": ["fast"]}, "flags": {"v": True}, "positional": []}
     7	    assert I.parse(["--mode", "fast", "-v"]) == {"values": {"mode": ["fast"]}, "flags": {"v": True}, "positional": []}
     8	
     9	def test_switch_when_no_value_follows():
    10	    assert I.parse(["--mode", "--other"]) == {"values": {}, "flags": {"mode": True, "other": True}, "positional": []}
    11	    assert I.parse(["--mode"]) == {"values": {}, "flags": {"mode": True}, "positional": []}
    12	
    13	def test_bundled_short_switches():
    14	    assert I.parse(["-abc"]) == {"values": {}, "flags": {"a": True, "b": True, "c": True}, "positional": []}
    15	
    16	def test_repeated_key_accumulates_in_order():
    17	    assert I.parse(["--k", "1", "--k", "2"])["values"] == {"k": ["1", "2"]}
    18	
    19	def test_repeated_switch_stays_true():
    20	    assert I.parse(["--x", "y", "--x"]) == {"values": {"x": ["y"]}, "flags": {"x": True}, "positional": []}
    21	
    22	def test_positional_and_dash_terminator():
    23	    assert I.parse(["a", "-", "b"])["positional"] == ["a", "-", "b"]
    24	    assert I.parse(["--", "--not-a-flag", "x"])["positional"] == ["--not-a-flag", "x"]
    25	    assert I.parse(["--", "--not-a-flag", "x"])["flags"] == {}
    26	
    27	def test_values_may_look_like_switches():
    28	    assert I.parse(["--k", "-5"])["values"] == {"k": ["-5"]}
    29	    assert I.parse(["--k=--v"])["values"] == {"k": ["--v"]}
    30	
    31	def test_empty_input():
    32	    assert I.parse([]) == {"values": {}, "flags": {}, "positional": []}
