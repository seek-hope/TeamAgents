===== units/chain/stage1.py =====
import csv


def parse_orders(path):
    rows = []
    with open(path, newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            rows.append({
                "id": int(row["id"]),
                "qty": int(row["qty"]),
                "price": int(row["price"]),
            })
    return rows
===== units/chain/stage2.py =====
def filter_orders(rows):
    return [row for row in rows if row["qty"] > 0]
===== units/chain/stage3.py =====
def total_by_price(rows):
    totals = {}
    for row in rows:
        totals[row["price"]] = totals.get(row["price"], 0) + row["qty"]
    return totals
