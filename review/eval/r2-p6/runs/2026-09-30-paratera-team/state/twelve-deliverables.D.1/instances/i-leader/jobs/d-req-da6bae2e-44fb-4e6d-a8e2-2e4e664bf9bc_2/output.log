===== units/measure/measure.py =====
class Impl:
    def to_cm(self, *args, **kwargs):
        raise NotImplementedError
===== units/measure/test_measure.py =====
from measure import Impl
I = Impl()
def test_cm():
    assert I.to_cm(1.5, "m") == 150
    assert I.to_cm(3, "cm") == 3
    assert I.to_cm(20, "mm") == 2
    try:
        I.to_cm(1, "ft")
    except ValueError:
        pass
    else:
        raise AssertionError("bad unit accepted")
===== units/slugify/slugify.py =====
class Impl:
    def slugify(self, *args, **kwargs):
        raise NotImplementedError
===== units/slugify/test_slugify.py =====
from slugify import Impl
I = Impl()
def test_slug():
    assert I.slugify("Hello, World!") == "hello-world"
    assert I.slugify("  --A@@B-- ") == "a-b"
    assert I.slugify("***") == "untitled"
===== units/ranges/ranges.py =====
class Impl:
    def merge(self, *args, **kwargs):
        raise NotImplementedError
===== units/ranges/test_ranges.py =====
from ranges import Impl
I = Impl()
def test_merge():
    assert I.merge([[5,7],[1,3],[2,4]]) == [(1,4),(5,7)]
    assert I.merge([]) == []
    assert I.merge([[1,1]]) == [(1,1)]
