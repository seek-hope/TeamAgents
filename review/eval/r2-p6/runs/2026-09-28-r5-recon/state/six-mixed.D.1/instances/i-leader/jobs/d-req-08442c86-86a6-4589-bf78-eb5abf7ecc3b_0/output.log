===== units/measure/measure.py =====
     1	class Impl:
     2	    _FACTORS = {"m": 100, "cm": 1, "mm": 0.1}
     3	
     4	    def to_cm(self, value, unit):
     5	        try:
     6	            factor = self._FACTORS[unit]
     7	        except KeyError:
     8	            raise ValueError(f"unsupported unit: {unit!r}")
     9	        return int(round(value * factor))
===== units/slugify/slugify.py =====
     1	import re
     2	
     3	
     4	class Impl:
     5	    def slugify(self, text):
     6	        text = "" if text is None else str(text)
     7	        lowered = text.lower()
     8	        # Replace each maximal run of non-alphanumeric characters with a single "-".
     9	        slug = re.sub(r"[^a-z0-9]+", "-", lowered)
    10	        slug = slug.strip("-")
    11	        if slug == "":
    12	            return "untitled"
    13	        return slug
===== units/ranges/ranges.py =====
     1	class Impl:
     2	    def merge(self, ranges):
     3	        """Merge a collection of closed intervals ``[start, end]``.
     4	
     5	        Intervals are sorted by start and combined whenever the next start is
     6	        not greater than the current end (i.e. they overlap or touch).
     7	
     8	        Returns a list of ``(start, end)`` tuples sorted by start.
     9	        """
    10	        if not ranges:
    11	            return []
    12	
    13	        items = sorted((start, end) for start, end in ranges)
    14	
    15	        merged = []
    16	        cur_start, cur_end = items[0]
    17	        for start, end in items[1:]:
    18	            if start <= cur_end:
    19	                if end > cur_end:
    20	                    cur_end = end
    21	            else:
    22	                merged.append((cur_start, cur_end))
    23	                cur_start, cur_end = start, end
    24	        merged.append((cur_start, cur_end))
    25	        return merged
