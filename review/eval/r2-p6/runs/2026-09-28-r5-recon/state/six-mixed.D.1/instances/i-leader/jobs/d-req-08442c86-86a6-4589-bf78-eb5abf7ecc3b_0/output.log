     1	import csv
     2	
     3	
     4	def parse_orders(path):
     5	    rows = []
     6	    with open(path, newline="") as f:
     7	        for rec in csv.DictReader(f):
     8	            rows.append(
     9	                {
    10	                    "id": int(rec["id"]),
    11	                    "qty": int(rec["qty"]),
    12	                    "price": int(rec["price"]),
    13	                }
    14	            )
    15	    return rows
===== units/chain/stage2.py =====
     1	def filter_orders(rows):
     2	    return [row for row in rows if row["qty"] > 0]
===== units/chain/stage3.py =====
     1	def total_by_price(rows):
     2	    totals = {}
     3	    for row in rows:
     4	        totals[row["price"]] = totals.get(row["price"], 0) + row["qty"]
     5	    return totals
