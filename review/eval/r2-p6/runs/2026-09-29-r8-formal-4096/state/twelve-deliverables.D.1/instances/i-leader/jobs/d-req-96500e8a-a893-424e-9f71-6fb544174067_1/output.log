--- units/chain/stage1.py
"""Stage 1: read the orders CSV into a list of dicts."""
import csv


def parse_orders(path):
    """Read ``path`` (header ``id,qty,price``) and return one dict per data row.

    Values are cast to ``int``; the header row is skipped.
    """
    rows = []
    with open(path, newline="") as fh:
        reader = csv.DictReader(fh)
        for row in reader:
            rows.append({
                "id": int(row["id"]),
                "qty": int(row["qty"]),
                "price": int(row["price"]),
            })
    return rows
--- units/chain/stage2.py
"""Stage 2: keep only orders with a positive quantity."""


def filter_orders(rows):
    """Return the rows whose ``qty`` is greater than zero, order preserved."""
    return [row for row in rows if row["qty"] > 0]
--- units/chain/stage3.py
"""Stage 3: aggregate total quantity per price."""


def total_by_price(rows):
    """Group ``rows`` by price and sum the quantities -> ``{price: total_qty}``."""
    totals = {}
    for row in rows:
        price = row["price"]
        totals[price] = totals.get(price, 0) + row["qty"]
    return totals
--- units/chain/stage4.py
"""Stage 4: render the totals as a report string."""


def report(totals):
    """Render ``{price: total_qty}`` as ``"{price}:{total}\\n"`` lines, price ascending."""
    return "".join(
        "{0}:{1}\n".format(price, totals[price])
        for price in sorted(totals)
    )
