+        {"op": "remove_agent", "agent_id": "b"}]}).ok
+    result = action(rt, ActionKind.APPLY_TOPOLOGY_PATCH, {"base_revision": 2, "operations": [
+        {"op": "add_agent", "agent": old}]})
