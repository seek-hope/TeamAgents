+def test_stale_proposal_is_rejected(rt):
+    proposal = action(rt, ActionKind.PROPOSE_TEAM_CHANGE, {"operations": [
+        {"op": "update_agent", "agent_id": "b", "changes": {"instructions": "old"}}]}, "b")
